{
  "name": "publication-trend-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Scientific Publication Trend Analysis System",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev dev:workers",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "node scripts/run-mobile.mjs expo",
    "dev:flutter_mobile": "node scripts/run-mobile.mjs flutter",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "clean": "turbo run clean",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:infra": "docker compose up -d postgres redis",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "1.55.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^11.0.7",
    "cross-spawn": "^7.0.6"
  }
}
