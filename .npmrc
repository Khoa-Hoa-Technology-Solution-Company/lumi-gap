strict-peer-dependencies=false
auto-install-peers=true
node-linker=hoisted

# Keep node-linker here as well as pnpm-workspace.yaml so cloud builders
# consistently create workspace package links for @trend/shared-types.

# Docker builds download every package at once and time out on slow links:
# fetch fewer in parallel, wait longer and retry more.
network-concurrency=4
fetch-timeout=120000
fetch-retries=5
