# Copy to .env.compose. This file is safe to commit; .env.compose is ignored.
# Generate the ignored RS256 key files with:
# pnpm --filter backend auth:keys:generate

# PostgreSQL + pgvector is the application database.
# POSTGRES_PASSWORD_URI is the URL-encoded form used in DATABASE_URL.
POSTGRES_USER=lumi_gap
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_PASSWORD_URI=replace-with-url-encoded-postgres-password
POSTGRES_DB=lumi_gap
POSTGRES_HOST_PORT=5433

# Redis is internal-only. REDIS_PASSWORD_URI is the URL-encoded form of the
# same password, used by backend and BullMQ in REDIS_URL.
REDIS_PASSWORD=replace-with-a-strong-url-safe-password
REDIS_PASSWORD_URI=replace-with-url-encoded-redis-password

JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=lumigap-api
JWT_AUDIENCE=lumigap-web

# Required for AI features. Replace before using report, gaps, rerank, analysis,
# embedding, or project AI chat.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Required only when the OpenAlex million-scale campaign worker is enabled.
# OpenAlex now requires a free API key for new API requests.
OPENALEX_API_KEY=
OPENALEX_MAILTO=your-team-email@example.com

# Browser requests go through the Nginx web container by default.
VITE_API_BASE=/api/v1

PORT=4000
LOG_LEVEL=info
STORAGE_PROVIDER=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LLM_PROVIDER=gemini

# Internal AI Reviewer service (Python FastAPI)
AI_REVIEWER_URL=http://ai-reviewer:8001
INTERNAL_SERVICE_KEY=replace-with-a-separate-random-secret-at-least-32-characters

# Paper Detail translation only. Keep disabled unless the Compose translation
# profile (or another LibreTranslate instance) is running.
TRANSLATION_PROVIDER=disabled
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_LOAD_ONLY=en,vi,es,fr,de,pt,zh,ja,ko,ru,id
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_MAX_PER_HOUR=30
