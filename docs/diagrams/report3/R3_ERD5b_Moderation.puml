@startuml
!pragma layout elk
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}

hide circle
hide empty methods
skinparam ArrowFontSize 11
skinparam ArrowFontColor #4A5A6A
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam stereotypeFontSize 10
title
ERD 5(b) - Content reports and moderation
<size:11><color:#4A5A6A>FK -> User : relation to the User entity is shown as an FK annotation</color></size>
end title
entity Community {
  * id : uuid <<PK>>
  --
  # owner_id : uuid <<FK>> -> User
  # reviewed_by_id : uuid <<FK>> -> User
  ..
  name : text
  visibility : text
  status : text
}
entity ForumPost {
  * id : uuid <<PK>>
  --
  # accepted_comment_id : uuid <<FK>>
  # author_id : uuid <<FK>> -> User
  # community_id : uuid <<FK>>
  # linked_paper_id : uuid <<FK>>
  # linked_project_id : uuid <<FK>>
  # linked_research_gap_id : uuid <<FK>>
  # research_gap_id : uuid <<FK>>
  ..
  type : text
  title : text
  status : text
}
entity ForumComment {
  * id : uuid <<PK>>
  --
  # author_id : uuid <<FK>> -> User
  # parent_comment_id : uuid <<FK>> (self)
  # post_id : uuid <<FK>>
  ..
  status : text
}
entity ContentReport {
  * id : uuid <<PK>>
  --
  # comment_id : uuid <<FK>>
  # community_id : uuid <<FK>>
  # post_id : uuid <<FK>>
  # reporter_id : uuid <<FK>> -> User
  # reviewed_by_id : uuid <<FK>> -> User
  ..
  reason : text
  status : text
}
entity ForumModerationAction {
  * id : uuid <<PK>>
  --
  # actor_id : uuid <<FK>> -> User
  # comment_id : uuid <<FK>>
  # community_id : uuid <<FK>>
  # post_id : uuid <<FK>>
  # report_id : uuid <<FK>>
  ..
  action : text
}
Community |o--o{ ForumPost : community_id
ForumPost ||--o{ ForumComment : post_id
ForumComment |o--o{ ForumPost : accepted_comment_id
ForumPost |o--o{ ContentReport : post_id
ForumComment |o--o{ ContentReport : comment_id
Community |o--o{ ContentReport : community_id
Community |o--o{ ForumModerationAction : community_id
ForumPost |o--o{ ForumModerationAction : post_id
ForumComment |o--o{ ForumModerationAction : comment_id
ContentReport |o--o{ ForumModerationAction : report_id
@enduml
