@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 5(b) - Content reports and moderation
entity ContentReport #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  reporterId <<FK User>>
  postId <<FK>>
  commentId <<FK>>
  communityId <<FK>>
  reviewedById <<FK User>>
  ..
  targetType
  status
}
entity ForumModerationAction #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  actorId <<FK User>>
  communityId <<FK>>
  postId <<FK>>
  commentId <<FK>>
  reportId <<FK>>
  ..
  targetType
  policyRuleCode
}
entity Community #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ForumPost #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ForumComment #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
Community |o--o{ ContentReport
Community |o--o{ ForumModerationAction
ForumComment |o--o{ ContentReport
ForumComment |o--o{ ForumModerationAction
ContentReport |o--o{ ForumModerationAction
ForumPost |o--o{ ContentReport
ForumPost |o--o{ ForumModerationAction
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
