@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 4(c) - Review templates and versions
entity ReviewTemplate #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  ownerId <<FK User>>
  projectId <<FK Project>>
  activeVersionId <<FK>>
  ..
  name
  submissionType
}
entity ReviewTemplateVersion #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  templateId <<FK>>
  createdById <<FK User>>
  ..
  versionNumber
  status
}
entity ReviewRequest #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity HumanReview #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ExternalReviewInvitation #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
ReviewTemplateVersion ||--o{ ExternalReviewInvitation
ReviewTemplateVersion |o--o{ HumanReview
ReviewTemplateVersion ||--o{ ReviewRequest
ReviewTemplateVersion |o--o{ ReviewTemplate : activeVersionId
ReviewTemplate |o--o{ HumanReview
ReviewTemplate ||--o{ ReviewTemplateVersion : templateId
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
