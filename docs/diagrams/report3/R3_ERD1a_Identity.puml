@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 1(a) - Users, sessions and capabilities
entity User #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  accountStatusChangedById <<FK>>
  email <<UK>>
  googleId <<UK>>
  ..
  fullName
  role
}
entity UserEmail #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK,UK*>>
  normalizedEmail <<UK>>
  ..
  isPrimary
  purpose
}
entity OAuthAccount #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  ..
  provider
  providerAccountId
}
entity RefreshToken #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  ..
  familyId
  rotatedToId
}
entity UserCapability #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  grantedById <<FK>>
  ..
  capability
  status
}
User ||--o{ OAuthAccount
User ||--o{ RefreshToken
User |o--o{ UserCapability : grantedById
User ||--o{ UserCapability : userId
User ||--o{ UserEmail
User |o--o{ User : accountStatusChangedById
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
