@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 3(d) - Contribution evaluation and manuscript attribution
entity ContributionEvaluationRule #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  createdById <<FK User>>
  ..
  title
  rationale
}
entity ContributionOutcome #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  createdById <<FK User>>
  ..
  key
}
entity ContributionOutcomeEvaluation #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  outcomeId <<FK>>
  ruleId <<FK>>
  createdById <<FK User>>
  ..
  clientKey
}
entity ContributionEvaluationSnapshot #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  periodId <<FK>>
  ruleId <<FK>>
  runId <<FK,UK ContributionEvaluationRun>>
  ..
  inputVersion
}
entity ManuscriptAttributionCheck #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  workspaceId <<FK DraftWorkspace>>
  snapshotId <<FK>>
  createdById <<FK User>>
  ..
  status
  acknowledgementText
}
entity ManuscriptAttributionDecision #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  checkId <<FK>>
  projectId <<FK>>
  userId <<FK User>>
  ..
  participantKind
  decision
}
entity Project #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity AllocationPeriod #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ManuscriptSnapshot #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
AllocationPeriod ||--o{ ContributionEvaluationSnapshot
ContributionEvaluationRule ||--o{ ContributionEvaluationSnapshot
ContributionEvaluationRule ||--o{ ContributionOutcomeEvaluation
ContributionOutcome ||--o{ ContributionOutcomeEvaluation
ManuscriptAttributionCheck ||--o{ ManuscriptAttributionDecision
ManuscriptSnapshot ||--o{ ManuscriptAttributionCheck
Project ||--o{ ContributionEvaluationRule
Project ||--o{ ContributionOutcome
Project ||--o{ ManuscriptAttributionCheck
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
