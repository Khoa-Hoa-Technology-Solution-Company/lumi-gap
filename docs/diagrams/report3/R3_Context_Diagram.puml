@startuml
!pragma layout elk
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam ranksep 40
skinparam nodesep 25
skinparam componentStyle rectangle
skinparam ArrowFontSize 11
skinparam ArrowFontColor #4A5A6A
skinparam rectangle<<ext>> {
  BackgroundColor #FDECEA
  BorderColor #C62828
}
skinparam rectangle<<client>> {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam rectangle<<svc>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam rectangle<<wrk>> {
  BackgroundColor #FFF4E5
  BorderColor #E08A00
}
skinparam database {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam actorStyle awesome
hide stereotype
skinparam rectangle<<bound>> {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  BorderThickness 2
}
title System Context Diagram
actor "Guest" as guest
actor "Student / Researcher" as user
actor "Lecturer" as lect
actor "Community moderator" as mod
actor "Administrator" as adm
rectangle "LumiGap system boundary" as LUMI <<bound>> {
  rectangle "React web app" as web <<client>>
  rectangle "Express REST API\n/api/v1" as api <<svc>>
  rectangle "BullMQ workers\nreport, gaps, embedding, sync,\ningest, notifications, ai-jobs" as wk <<wrk>>
  rectangle "AI Reviewer service\n(FastAPI, internal)" as rev <<svc>>
  database "PostgreSQL\n+ pgvector" as db
  database "Redis" as rd
}
rectangle "OpenAlex" as oa <<ext>>
rectangle "Gemini / Ollama /\nuser AI provider" as llm <<ext>>
rectangle "Google OIDC" as goo <<ext>>
rectangle "PayOS" as pay <<ext>>
rectangle "SMTP mail server" as smtp <<ext>>
rectangle "LibreTranslate /\nGemini translation" as lt <<ext>>
rectangle "Storage: local /\nCloudflare R2 / Cloudinary" as st <<ext>>
rectangle "GitHub" as gh <<ext>>
guest --> web : search, trends, forum read
user --> web : research, projects, credits
lect --> web : verification, mentoring, review
mod --> web : moderation actions
adm --> web : users, corpus, sync, pipeline
web --> api
api --> db
api --> rd
api --> wk
wk --> db
api --> rev : X-Internal-Key
wk --> rev : pre-review
api <--> goo : OAuth
api <--> pay : payment link, webhook
api --> smtp : emails
api --> lt
api <--> st
api <--> gh
api --> llm
wk --> oa : metadata
wk --> llm
@enduml
