@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 3(c) - Collaborative screening
entity ScreeningSettings #EFE6F8;line:6A3FA0 {
  * projectId <<PK,FK>>
  --
  preferredAdjudicatorId
  adjudicationReminderHours
}
entity ScreeningRound #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  finalizerId <<FK User>>
  projectId <<FK>>
  paperId <<FK ProjectPaper>>
  createdById <<FK User>>
  ..
  legacyNeedsAudit
  status
}
entity ScreeningAssignment #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  roundId <<FK>>
  reviewerId <<FK User>>
  ..
  active
  revision
}
entity ScreeningReview #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  assignmentId <<FK>>
  ..
  revision
  decision
}
entity ScreeningFinalDecision #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  roundId <<FK>>
  resolverId <<FK User>>
  ..
  resolutionType
  decision
}
entity ScreeningAdjudicationCase #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  finalDecisionId <<FK,UK>>
  projectId <<FK>>
  roundId <<FK,UK*>>
  ..
  active
  status
}
entity ScreeningAdjudicationInvitation #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  caseId <<FK,UK*>>
  userId <<FK User>>
  ..
  role
  status
}
entity Project #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity Paper #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
Project ||--o| ScreeningSettings
ScreeningAdjudicationCase ||--o{ ScreeningAdjudicationInvitation
ScreeningAssignment ||--o{ ScreeningReview
ScreeningFinalDecision |o--o{ ScreeningAdjudicationCase
ScreeningRound ||--o{ ScreeningAdjudicationCase
ScreeningRound ||--o{ ScreeningAssignment
ScreeningRound ||--o{ ScreeningFinalDecision
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
