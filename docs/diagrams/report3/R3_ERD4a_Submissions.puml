@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 4(a) - Submissions and contributions
entity Submission #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  sourceReportId <<FK,UK>>
  createdById <<FK User>>
  currentRevisionId <<FK>>
  ..
  title
  submissionType
}
entity SubmissionRevision #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  submissionId <<FK>>
  uploadedById <<FK User>>
  sourceRevisionId <<FK>>
  manuscriptSnapshotId <<FK ManuscriptSnapshot>>
  ..
  originalFileName
  contentType
}
entity AiPreReview #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  submissionId <<FK>>
  requestedById <<FK User>>
  ..
  provider
  status
}
entity ResearchContribution #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  contributorId <<FK User>>
  projectId <<FK>>
  submissionId <<FK>>
  verifiedById <<FK User>>
  sourceReviewAssignmentId <<FK,UK>>
  sourceProjectContributionId <<FK ProjectContributionProposal>>
  ..
  contributionType
  verificationStatus
}
entity Project #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity Report #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ReviewerAssignment #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
Project |o--o{ ResearchContribution
Project ||--o{ Submission
Report |o--o| Submission
ReviewerAssignment |o--o| ResearchContribution
SubmissionRevision |o--o{ ReviewerAssignment
SubmissionRevision |o--o{ SubmissionRevision : sourceRevisionId
SubmissionRevision |o--o{ Submission : currentRevisionId
Submission ||--o{ AiPreReview
Submission |o--o{ ResearchContribution
Submission ||--o{ ReviewerAssignment
Submission ||--o{ SubmissionRevision : submissionId
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
