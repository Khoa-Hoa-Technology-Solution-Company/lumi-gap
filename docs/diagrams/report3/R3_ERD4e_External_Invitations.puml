@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 4(e) - External review invitations
entity ExternalReviewInvitation #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  invitedUserId <<FK User>>
  requesterId <<FK User>>
  submissionId <<FK>>
  projectId <<FK>>
  templateVersionId <<FK>>
  artifactRevisionId <<FK>>
  tokenHash <<UK>>
  ..
  reviewerEmail
  status
}
entity Project #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity Submission #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity SubmissionRevision #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ReviewTemplateVersion #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
Project ||--o{ ExternalReviewInvitation
ReviewTemplateVersion ||--o{ ExternalReviewInvitation
SubmissionRevision ||--o{ ExternalReviewInvitation
Submission ||--o{ ExternalReviewInvitation
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
