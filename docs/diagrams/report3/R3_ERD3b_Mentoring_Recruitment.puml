@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 3(b) - Mentoring and recruitment
entity MentorshipRequest #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  mentorUserId <<FK User>>
  requestedBy <<FK User>>
  ..
  mentorRole
  status
}
entity MentorRelationship #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  mentorUserId <<FK User>>
  sourceRequestId <<FK,UK>>
  ..
  mentorRole
  status
}
entity RecruitmentOpening #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  projectId <<FK>>
  createdById <<FK User>>
  ..
  title
  status
}
entity RecruitmentApplication #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  openingId <<FK>>
  projectId <<FK>>
  applicantId <<FK User>>
  decidedById <<FK User>>
  ..
  coverLetter
  status
}
entity Project #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
MentorshipRequest ||--o| MentorRelationship
Project ||--o{ MentorRelationship
Project ||--o{ MentorshipRequest
Project ||--o{ RecruitmentApplication
Project ||--o{ RecruitmentOpening
RecruitmentOpening ||--o{ RecruitmentApplication
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
