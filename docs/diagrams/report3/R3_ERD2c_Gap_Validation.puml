@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 2(c) - Gap evidence, validation and directions
entity GapDirections #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  gapId <<FK,UK>>
  creditTransactionId <<FK>>
  ..
  model
  promptVersion
}
entity GapValidation #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  gapId <<FK>>
  reviewerId <<FK User>>
  ..
  gapVersion
  action
}
entity GapEvidenceRecord #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  gapId <<FK>>
  paperId <<FK>>
  evidenceItemId <<FK ProjectEvidenceItem>>
  evidenceRevisionId <<FK ProjectWorkspaceRevision>>
  projectPaperId <<FK ProjectPaper>>
  corpusPaperId <<FK CorpusPaper>>
  forumReferenceId <<FK ForumReference>>
  forumPostId <<FK ForumPost>>
  forumCommentId <<FK ForumComment>>
  addedById <<FK User>>
  ..
  evidenceKind
  evidenceType
}
entity ResearchGap #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity Paper #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity CreditTransaction #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
CreditTransaction |o--o{ GapDirections
Paper ||--o{ GapEvidenceRecord
ResearchGap ||--o| GapDirections
ResearchGap ||--o{ GapEvidenceRecord
ResearchGap ||--o{ GapValidation
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
