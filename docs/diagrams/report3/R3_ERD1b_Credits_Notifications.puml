@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 1(b) - Credits, payments and notifications
entity CreditTransaction #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  refundedTransactionId <<FK>>
  idempotencyKey <<UK>>
  ..
  type
  amount
}
entity PaymentOrder #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  orderCode <<UK>>
  ..
  amount
  status
}
entity Notification #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  paperId <<FK Paper>>
  eventKey <<UK>>
  ..
  role
  title
}
entity AuditLog #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  userId <<FK>>
  ..
  actionName
  targetTableName
}
entity User #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
CreditTransaction |o--o{ CreditTransaction : refundedTransactionId
User |o--o{ AuditLog
User ||--o{ CreditTransaction
User |o--o{ Notification
User ||--o{ PaymentOrder
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
