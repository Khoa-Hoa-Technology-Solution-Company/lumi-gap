@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Logical ERD 2(d) - Curated tags
entity Tag #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  createdById <<FK User>>
  slug <<UK>>
  ..
  name
  status
}
entity TagRule #EFE6F8;line:6A3FA0 {
  * id <<PK>>
  --
  tagId <<FK>>
  researchTopicId <<FK>>
  keywordId <<FK>>
  ..
  ruleKind
  effect
}
entity PaperTag #EFE6F8;line:6A3FA0 {
  * paperId <<PK,FK>>
  * tagId <<PK,FK>>
  --
  source
  confidence
}
entity Paper #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity ResearchTopic #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
entity Keyword #FFFFFF;line:6A3FA0;line.dashed {
  * id <<PK>>
}
Keyword |o--o{ TagRule
Paper ||--o{ PaperTag
ResearchTopic |o--o{ TagRule
Tag ||--o{ PaperTag
Tag ||--o{ TagRule
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references an entity that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
