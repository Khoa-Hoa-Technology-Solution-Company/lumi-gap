@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Scholarly corpus: author affiliations, downloads and quality checks (3 of 4)
entity author_affiliations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  author_id : uuid <<FK>>
  ..
  name : text
  country : text
}
entity journal_issns #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  journal_id : uuid <<FK>>
  ..
  issn : varchar(32)
}
entity paper_downloads #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK>>
  user_id : uuid <<FK users>>
  ..
  cost : integer
}
entity paper_format_checks #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK users>>
  ..
  file_name : text
  preset : text
}
entity paper_quality_checks #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK,UK>>
  ..
  has_title : boolean
  has_doi : boolean
}
entity authors #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity journals #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
authors ||--o{ author_affiliations
journals ||--o{ journal_issns
papers ||--o{ paper_downloads
papers ||--o| paper_quality_checks
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
