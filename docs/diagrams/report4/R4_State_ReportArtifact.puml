@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title Report artifact status (reports.artifact_status)
[*] --> DRAFT : create()\n/ default artifactStatus
DRAFT --> REVIEWING : markArtifactReviewing()\n/ on review request
REVIEWING --> DRAFT : releaseArtifactReviewing()\n[no active or completed review]
DRAFT --> FINAL : updateArtifactStatus()\n[1 completed review]
FINAL --> DRAFT : updateArtifactStatus()\n[no active review]
DRAFT --> ARCHIVED : updateArtifactStatus()
FINAL --> ARCHIVED : updateArtifactStatus()
ARCHIVED --> DRAFT : updateArtifactStatus()
ARCHIVED --> FINAL : updateArtifactStatus()\n[1 completed review]
note right of REVIEWING
  Set by review-request.service only.
  While review requests are active, updateArtifactStatus()
  allows only REVIEWING (artifactStatusChangeError).
end note
@enduml
