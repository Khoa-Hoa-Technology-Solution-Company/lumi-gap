@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF01 Report worker (a): claim, embed, retrieve
queue "report\nqueue" as Q #EFE6F8
control "report.worker" as K <<worker>> #FFF1DC
control "ragService" as P #E3F2E5
database "PostgreSQL" as DB #EFE6F8
participant "embedding\nProvider" as E <<external>> #F0F1F3
Q ->> K : deliver job generate-report
activate K
K -> P : runRagPipeline(reportId)\ninside withUserAi
activate P
P -> DB : claim: status queued\nto generating
P -> E : embed(query)
alt embedding fails
  E --> P : error (text-search fallback)
else embedding ok
  E --> P : query vector
end
P -> DB : collectReportEvidence\n(vector and text search)
DB --> P : evidence papers
P -> DB : save evidenceSnapshot
alt no evidence
  P -> DB : markReportFailed,\nrefundCreditsOnce
  P --> K : done
else evidence found
  note over P : continues in (b)
end
deactivate P
deactivate K
@enduml
