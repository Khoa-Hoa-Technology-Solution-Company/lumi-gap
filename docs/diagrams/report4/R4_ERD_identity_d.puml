@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Account links, handles and email challenges (4 of 7)
entity academic_identity_links #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK,UK*>>
  ..
  provider : varchar(32)
  status : varchar(24)
}
entity academic_profile_handles #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  handle : varchar(40) <<UK>>
}
entity academic_email_verification_challenges #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK>>
  ..
  email : varchar(320)
  attempts : integer
}
entity users #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
users ||--o{ academic_email_verification_challenges
users ||--o{ academic_identity_links
users ||--o{ academic_profile_handles
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
Dashed boxes belong to another diagram (key only).
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
