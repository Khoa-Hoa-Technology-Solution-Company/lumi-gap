@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title ReviewRequest status (a): request and answer (review_requests.status)
[*] --> REQUESTED : reviewRequestService.create()
[*] --> ACCEPTED : acceptExternalInvitation()
REQUESTED --> ACCEPTED : accept()
REQUESTED --> DECLINED : decline()
REQUESTED --> CANCELLED : cancel()
REQUESTED --> EXPIRED : expireReviewRequests()\n[expiresAt passed]
ACCEPTED --> DECLINED : decline()\n[no round submitted]
ACCEPTED --> CANCELLED : cancel() [after deadline]
ACCEPTED --> ACCEPTED : continues in (b)\n(saveReview)
DECLINED --> [*]
CANCELLED --> [*]
EXPIRED --> [*]
legend bottom
  <b>Dead value</b>: SUBMITTED is in the DB CHECK constraint and in
  ACTIVE_REVIEW_REQUEST_STATUSES but is never written by any service.
endlegend
@enduml
