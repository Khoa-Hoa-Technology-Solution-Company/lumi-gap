@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Mentor recruitment plan and candidates
entity mentor_invitation_plans #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK,UK*>>
  created_by_id : uuid <<FK>>
  ..
  status : varchar(16)
  parallel_invitations : boolean
}
entity mentor_candidates #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  plan_id : uuid <<FK>>
  mentor_user_id : uuid <<FK>>
  ..
  mentor_role : varchar(16)
  status : varchar(16)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity mentorship_requests #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity users #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
mentor_candidates |o--o| mentorship_requests
mentor_invitation_plans ||--o{ mentor_candidates
projects ||--o{ mentor_invitation_plans
users ||--o{ mentor_candidates
users ||--o{ mentor_invitation_plans
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
Dashed boxes belong to another diagram (key only).
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
