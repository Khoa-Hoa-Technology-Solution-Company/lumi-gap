@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Research gaps and analyses (2 of 7)
entity gap_analyses #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK users>>
  project_id : uuid <<FK>>
  credit_transaction_id : uuid <<FK>>
  ..
  topic : text
  status : varchar(24)
}
entity gap_analysis_papers #EFE6F8;line:6A3FA0 {
  * analysis_id : uuid <<PK,FK>>
  * paper_id : uuid <<PK,FK>>
  --
  position : integer
}
entity research_gaps #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  source_report_id : uuid <<FK>>
  analysis_id : uuid <<FK>>
  user_id : uuid <<FK users>>
  project_id : uuid <<FK>>
  corpus_id : uuid <<FK literature_corpora>>
  latest_closure_check_id : uuid <<FK gap_closure_checks>>
  ..
  title : varchar(200)
  gap_type : varchar(64)
}
entity research_gap_papers #EFE6F8;line:6A3FA0 {
  * gap_id : uuid <<PK,FK>>
  * paper_id : uuid <<PK,FK>>
  * kind : varchar(16) <<PK>>
  --
  position : integer
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity credit_transactions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity reports #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
credit_transactions |o--o{ gap_analyses
gap_analyses ||--o{ gap_analysis_papers
gap_analyses |o--o{ research_gaps
papers ||--o{ gap_analysis_papers
papers ||--o{ research_gap_papers
projects |o--o{ gap_analyses
projects |o--o{ research_gaps
reports |o--o{ research_gaps
research_gaps ||--o{ research_gap_papers
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
