@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Review templates and versions (3 of 7)
entity review_templates #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  owner_id : uuid <<FK users>>
  project_id : uuid <<FK>>
  active_version_id : uuid <<FK>>
  ..
  name : varchar(200)
  submission_type : text
}
entity review_template_versions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  template_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  version_number : integer
  status : varchar(16)
}
entity review_criteria #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  template_id : uuid <<FK>>
  version_id : uuid <<FK>>
  ..
  key : varchar(80)
  label : varchar(160)
}
entity review_criterion_levels #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  criterion_id : uuid <<FK>>
  ..
  label : varchar(120)
  description : text
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity human_reviews #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity review_requests #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity external_review_invitations #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity review_responses #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
projects |o--o{ review_templates
review_criteria ||--o{ review_criterion_levels
review_criterion_levels |o--o{ review_responses
review_template_versions ||--o{ external_review_invitations
review_template_versions |o--o{ human_reviews
review_template_versions ||--o{ review_criteria
review_template_versions ||--o{ review_requests
review_template_versions |o--o{ review_templates : active_version_id
review_templates |o--o{ human_reviews
review_templates ||--o{ review_criteria
review_templates ||--o{ review_template_versions : template_id
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
