}
rectangle "Other contexts used\n[auth, authorization, notifications, credits, identity, llm, knowledge, papers]" as N11
rectangle "SMTP server\n[SMTP]\ninvitation mail" as N12
rectangle "LaTeX compiler «optional»\n[HTTP]\nmanuscript compile" as N13
rectangle "BullMQ workers\n[community-summary, ai-jobs]\njobs" as N14
