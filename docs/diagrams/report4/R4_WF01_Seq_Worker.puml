@startuml
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF01 Report generation worker - sequence
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
queue "BullMQ report queue" as Q
control "report.worker.ts" as K <<worker>>
control "ragService\nrunRagPipeline" as P
database "PostgreSQL" as DB
participant "embeddingProvider\n(Gemini)" as E <<external>>
participant "llmRun.cachedGenerate\n(Redis cache, Gemini\nor user AI)" as L <<external>>
control "gapsService" as G
control "notificationService" as N
Q -> K : job generate-report
K -> P : runRagPipeline(reportId)\ninside withUserAi
activate P
P -> DB : updateMany status queued to generating (claim)
P -> E : embed(query)\n(falls back to text search on error)
P -> DB : collectReportEvidence\n(vector and text search, selected papers)
P -> DB : save evidenceSnapshot
alt no evidence
  P -> DB : markReportFailed + refundCreditsOnce
else evidence found
  P -> L : cachedGenerate(prompt)\n(optional MCP tools in deep mode)
  L --> P : markdown + gaps
  P -> P : assert citations in range, grounding checks
  P -> DB : tx update reports (ready),\nreplace grounding report_papers
  opt cache hit
    P -> DB : refundCreditsOnce
  end
  P -> DB : insert rag_queries, rag_query_results
  P -> N : create(report_ready)
  P -> G : enqueueReportGapFanout (gaps queue)
end
deactivate P
K --> Q : complete, or on final failure markReportFailed
@enduml
