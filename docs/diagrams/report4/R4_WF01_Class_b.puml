@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam classAttributeIconSize 0
skinparam ClassFontSize 12
skinparam ClassAttributeFontSize 12
skinparam nodesep 25
skinparam ranksep 40
skinparam class<<page>> { 
  BackgroundColor #DCEAFB
}
skinparam class<<hook>> {
  BackgroundColor #DCEAFB
}
skinparam class<<api client>> {
  BackgroundColor #DCEAFB
}
skinparam class<<route>> {
  BackgroundColor #E3F2E5
}
skinparam class<<controller>> {
  BackgroundColor #E3F2E5
}
skinparam class<<service>> {
  BackgroundColor #E3F2E5
}
skinparam class<<rules>> {
  BackgroundColor #E3F2E5
}
skinparam class<<client>> {
  BackgroundColor #F0F1F3
}
skinparam class<<worker>> {
  BackgroundColor #FFF1DC
}
skinparam class<<job>> {
  BackgroundColor #FFF1DC
}
skinparam class<<model>> {
  BackgroundColor #EFE6F8
}
skinparam class<<external>> {
  BackgroundColor #F0F1F3
}
title WF01 Generate research report - class diagram (b) generation pipeline
hide empty members
hide circle
package "Worker" {
  class reportWorker <<worker>> {
    workers/report.worker.ts
    startup sweep stuck reports
  }
}
package "Services" {
  class ragService <<service>> {
    runRagPipeline(job)
    markReportFailed(id, msg)
  }
  class reportEvidence <<service>> {
    collectReportEvidence()
  }
  class reportPrompt <<service>> {
    buildReportPrompt()
    PROMPT_VERSION
  }
  class llmRun <<service>> {
    cachedGenerate()
    buildLlmCacheKey()
  }
  class embeddingProvider <<client>> {
    embed(text)
  }
  class gapsService <<service>> {
    enqueueReportGapFanout()
    fanOutGapsFromReport()
  }
  class notificationService <<service>> {
    create()
  }
  class creditService <<service>> {
    chargeCreditsChecked()
    refundCreditsOnce()
  }
}
package "Clients" {
  class geminiClient <<client>> {
    generateJSON()
    generateWithTools()
  }
}
package "Data model (Prisma)" {
  class Report <<model>> {
    reports
    id, userId, projectId
    status, artifactStatus
    markdown, creditTransactionId
  }
  class RagQuery <<model>> {
    rag_queries
  }
  class CreditTransaction <<model>> {
    credit_transactions
  }
}
reportWorker ..> ragService
ragService ..> reportEvidence
ragService ..> reportPrompt
ragService ..> llmRun
llmRun ..> geminiClient
ragService ..> embeddingProvider
ragService ..> Report
ragService ..> RagQuery
ragService ..> creditService
ragService ..> gapsService
ragService ..> notificationService
creditService ..> CreditTransaction

Report "1" -- "0..*" RagQuery
@enduml
