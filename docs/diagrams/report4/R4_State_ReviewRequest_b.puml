@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title ReviewRequest status (b): review rounds (review_requests.status)
[*] --> ACCEPTED : (from a)
ACCEPTED --> IN_REVIEW : saveReview() [draft]
ACCEPTED --> COMPLETED : saveReview(submit)\n[no revision needed]
ACCEPTED --> REVISION_REQUESTED : saveReview(submit)\n[revision needed]
IN_REVIEW --> COMPLETED : saveReview(submit)\n[no revision needed]
IN_REVIEW --> REVISION_REQUESTED : saveReview(submit)\n[revision needed]
IN_REVIEW --> DECLINED : decline()\n[no round submitted]
IN_REVIEW --> CANCELLED : cancel() [after deadline]
REVISION_REQUESTED --> RESUBMITTED : resubmit()
RESUBMITTED --> IN_REVIEW : saveReview() [draft]
RESUBMITTED --> COMPLETED : saveReview(submit)\n[no revision needed]
RESUBMITTED --> REVISION_REQUESTED : saveReview(submit)\n[revision needed]
COMPLETED --> [*]
DECLINED --> [*]
CANCELLED --> [*]
@enduml
