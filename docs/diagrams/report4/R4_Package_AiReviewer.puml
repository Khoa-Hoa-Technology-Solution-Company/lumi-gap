@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam entity<<ref>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
  FontStyle bold
}
skinparam rectangle {
  FontSize 12
}
skinparam ArrowFontSize 12
skinparam ArrowFontColor #1B2A3A
left to right direction
title ai-reviewer package structure (apps/ai-reviewer/app)
package "apps/ai-reviewer/app" as APP {
  rectangle "main.py (FastAPI app)" as M #EAF2FB
  rectangle "internal_routes.py, rag_routes.py\n(internal API, X-Internal-Key)" as R1 #E8F5E9;line:2E7D32
  rectangle "account_routes.py, admin_routes.py,\nformat_routes.py, storage_routes.py\n(standalone reviewer UI APIs)" as R2 #E8F5E9;line:2E7D32
  rectangle "pre_review.py, reviewer.py, review_types.py" as P1 #FFF4E5;line:E08A00
  rectangle "format_checker.py, format_db.py" as P2 #FFF4E5;line:E08A00
  rectangle "pdf_utils.py, rag_extraction.py, pdf_comparison.py" as P3 #FFF4E5;line:E08A00
  rectangle "pdf_to_latex.py, pdf_to_latex_structured.py,\npdf_structured_*.py, pdf_to_latex_worker.py, importer.py" as P4 #FFF4E5;line:E08A00
  rectangle "db.py, accounts_db.py, admin_db.py,\nstorage_db.py (SQLite)" as D1 #F3E5F5;line:7B1FA2
  rectangle "security.py, storage_subscription.py, storage_mail.py,\nstorage_maintenance.py, storage.py" as S1 #EAF2FB
  rectangle "config.py" as C #EAF2FB
}
M -down-> R1
M -down-> R2
R1 -down-> P1
R1 -down-> P2
R1 -down-> P3
R1 -down-> P4
R2 -down-> D1
R2 -down-> S1
P1 -down-> D1
P1 -down-> C

@enduml
