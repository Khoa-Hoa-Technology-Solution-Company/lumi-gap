@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF02 Expert validation (b): queue and decision
boundary "Web app" as W #DCEAFB
control "gapsRouter" as R #E3F2E5
control "gapValidation\nService" as V #E3F2E5
control "capability\nService" as K #E3F2E5
database "PostgreSQL" as DB #EFE6F8
W -> R : GET /gaps/validation-queue
R -> V : listValidationQueue(userId)
V --> R : gaps (own and same-\nproject excluded)
R --> W : 200 queue
W -> R : POST /gaps/:id/validations
activate R
R -> V : addValidation(gapId,\nreviewerId, input)
activate V
V -> K : assertExpert\n(GAP_VALIDATION active)
V -> DB : tx: lock research_gaps\nFOR UPDATE
alt no capability, own gap, member,\nnot open, stale version, archived
  V --> R : AppError 403 or 409
  R --> W : 403 / 409
else allowed
  V -> DB : insert gap_validations\n(gapVersion)
  V -> V : resolveValidationStatus\n(decisions, action, quorum)
  V -> DB : update validation_status
  V --> R : validation record
  R --> W : 201 validation
end
deactivate V
deactivate R
@enduml
