<mxfile><diagram name="p1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="920" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:28px&quot;&gt;Container diagram (C4 level 2c): sidecar services&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=28;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1460" height="40" as="geometry"/></mxCell><mxCell id="c4" value="LumiGap  [Software System]" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1E6FD9;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#444444;fontStyle=1;fontSize=19;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="1500" height="700" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Express API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[Node 22, Express 5]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Calls ai-reviewer for pre-review and format check; calls the compiler for manuscripts&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#ffffff;strokeColor=#1F5A23;fontSize=19;" vertex="1" parent="1"><mxGeometry x="10" y="90" width="470" height="250" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;BullMQ workers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[ai-jobs, manuscript-compile]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;ai-jobs: submission pre-review; manuscript-compile and PDF import: LaTeX&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E08A00;fontColor=#ffffff;strokeColor=#A86600;fontSize=19;" vertex="1" parent="1"><mxGeometry x="700" y="460" width="400" height="250" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;ai-reviewer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-