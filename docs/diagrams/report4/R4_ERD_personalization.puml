@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Topic follows and mutes for the For you feed
entity user_topic_follows #EFE6F8;line:6A3FA0 {
  * user_id : uuid <<PK,FK>>
  * topic_key : varchar(120) <<PK>>
  --
  label : varchar(200)
}
entity user_topic_mutes #EFE6F8;line:6A3FA0 {
  * user_id : uuid <<PK,FK>>
  * topic_key : varchar(120) <<PK>>
  --
  label : varchar(200)
}
entity users #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
users ||--o{ user_topic_follows
users ||--o{ user_topic_mutes
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
