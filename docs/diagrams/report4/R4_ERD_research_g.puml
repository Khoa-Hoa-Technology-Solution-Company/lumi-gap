@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Ratings and quality evaluations (7 of 7)
entity user_ratings #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK users>>
  paper_id : uuid <<FK>>
  report_id : uuid <<FK>>
  gap_id : uuid <<FK>>
  ..
  stars : integer
  comment : text
}
entity quality_evaluations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK,UK*>>
  report_id : uuid <<FK,UK*>>
  gap_id : uuid <<FK,UK*>>
  ..
  relevance : integer
  groundedness : integer
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity reports #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity research_gaps #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
papers |o--o| quality_evaluations
papers |o--o{ user_ratings
reports |o--o| quality_evaluations
reports |o--o{ user_ratings
research_gaps |o--o| quality_evaluations
research_gaps |o--o{ user_ratings
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
