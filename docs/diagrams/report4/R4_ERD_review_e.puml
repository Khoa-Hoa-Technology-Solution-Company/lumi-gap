@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - AI runs, run evidence and review conflicts (5 of 7)
entity ai_runs #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  owner_id : uuid <<FK users>>
  project_id : uuid <<FK projects>>
  workspace_id : uuid <<FK draft_workspaces>>
  ..
  job_type : varchar(32)
  status : varchar(24)
}
entity ai_run_evidence #EFE6F8;line:6A3FA0 {
  * run_id : uuid <<PK,FK>>
  * evidence_id : uuid <<PK>>
  --
  position : integer
}
entity review_conflicts #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  submission_id : uuid <<FK>>
  reviewer_id : uuid <<FK users>>
  resolved_by_id : uuid <<FK users>>
  ..
  status : varchar(24)
  reason : text
}
entity submission_declared_conflicts #EFE6F8;line:6A3FA0 {
  * submission_id : uuid <<PK,FK>>
  * user_id : uuid <<PK,FK users>>
  --
}
entity submissions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
ai_runs ||--o{ ai_run_evidence
submissions ||--o{ review_conflicts
submissions ||--o{ submission_declared_conflicts
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
