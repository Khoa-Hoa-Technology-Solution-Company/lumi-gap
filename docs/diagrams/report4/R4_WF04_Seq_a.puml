title WF04 Lecturer verification - submission (part a)
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "Lecturer" as L
boundary "Web\nlecturer-verification-status,\nadmin page" as W
control "academicProfile\nRouter" as R
control "academicProfile\nService" as P
control "lecturerVerification\nService" as LV
participant "verificationEvidence\nStorage" as ST
database "PostgreSQL" as DB
control "capability\nService" as C
control "notification\nService" as N
L -> W : choose path, institution evidence\n(profile URL, document)
W -> R : POST /academic-profiles/me/verification-evidence\n(stage file)
R -> ST : save private object
W -> R : POST /academic-profiles/me/verification-request
R -> P : requestVerification(userId, input)
P -> LV : submitLecturerVerification()
activate LV
LV -> DB : tx lock user, check no PENDING,\nsupersede NEEDS_MORE_INFORMATION
LV -> DB : insert verification_evidence (PENDING) and sources,\nprofile statuses PENDING
LV -> N : LECTURER_VERIFICATION_SUBMITTED
deactivate LV
@enduml
