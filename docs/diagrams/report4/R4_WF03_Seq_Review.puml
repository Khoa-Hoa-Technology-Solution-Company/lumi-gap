@startuml
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF03 Review request and review rounds - sequence
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "Author or\nproject owner" as A
actor "Verified lecturer\n(reviewer)" as V
boundary "Web\nreview-request-detail,\nreview-workspace" as W
control "reviewRequestService" as RQ
control "reviewService" as RV
control "peerReviewAccess" as PA
database "PostgreSQL" as DB
control "notificationService" as N
A -> W : choose artifact, reviewer and template version
W -> RQ : POST /review-requests (create)
RQ -> DB : tx insert review_requests (REQUESTED),\nreviewer_assignments (assigned),\nsubmission under_review
RQ -> N : notify reviewer
V -> W : accept
W -> RQ : POST /review-requests/:id/accept
RQ -> PA : assertPeerReviewer, assertReviewAdmission
RQ -> DB : request ACCEPTED, assignment accepted
V -> W : write review
W -> RV : POST /reviews/:assignmentId (draft) then /submit
RV -> DB : upsert human_reviews, review_responses,\nreview_revision_items
RV -> DB : request IN_REVIEW on draft
RV -> DB : on submit: request COMPLETED or REVISION_REQUESTED,\nassignment completed or accepted
RV -> PA : refreshSubmissionReviewStatus
RV -> N : notify requester
opt revision requested
  A -> W : upload revised version
  W -> RQ : POST /review-requests/:id/resubmit
  RQ -> DB : items ADDRESSED, request RESUBMITTED
  V -> W : accept or reopen each item (PATCH revision-items)
end
@enduml
