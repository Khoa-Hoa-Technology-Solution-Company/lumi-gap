@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Forum votes, follows and reactions (4 of 5)
entity forum_votes #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  post_id : uuid <<FK>>
  comment_id : uuid <<FK>>
  user_id : uuid <<FK users>>
  ..
  value : integer
}
entity forum_thread_follows #EFE6F8;line:6A3FA0 {
  * post_id : uuid <<PK,FK>>
  * user_id : uuid <<PK,FK users>>
  --
  notification_level : varchar(16)
}
entity forum_reactions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  target_type : varchar(16)
  target_id : uuid
}
entity forum_posts #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity forum_comments #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
forum_comments |o--o{ forum_votes
forum_posts ||--o{ forum_thread_follows
forum_posts |o--o{ forum_votes
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
