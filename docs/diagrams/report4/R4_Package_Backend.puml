@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam entity<<ref>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
  FontStyle bold
}
skinparam rectangle {
  FontSize 12
}
skinparam ArrowFontSize 12
skinparam ArrowFontColor #1B2A3A
title Backend package structure (apps/backend/src)
package "Entry points" as TOPG #EAF2FB {
  rectangle "**workers**\nreport, gaps, ai-jobs, embedding,\npaper-analysis, notification,\ncorpus-validation, community-summary,\nmanuscript-compile, sync, openalex-ingest" as WKR #FFF4E5;line:E08A00
}
package "Core and cross-cutting" as CORE #EAF2FB {
  rectangle "app.ts, server.ts, routes/index.ts\n**config**: env.ts, load-env.ts, production-env-validator.ts\n**common**: middleware, authorization, exceptions, validation\n**infrastructure**: database, queue, redis, cache, pdf-storage,\ncloudinary-storage, worker-heartbeat, readiness, logger\n**generated**: Prisma client" as COREB #EAF2FB;line:2F6DB5
}
package "Identity and access" as ID {
  rectangle "auth\nacademic-profiles\nidentity\nverification\nauthorization\nuser-ai\ngithub" as IDB #E8F5E9;line:2E7D32
}
package "Scholarly corpus and retrieval" as SC {
  rectangle "papers\nsearch\nretrieval\nembeddings\nknowledge\nscoring\nliterature\napi-sync\ntrends\nbookmarks" as SCB #E8F5E9;line:2E7D32
}
package "AI and research analysis" as AI {
  rectangle "llm\nmcp\nreports\ngaps\ngap-closure\nquality\nai-jobs" as AIB #E8F5E9;line:2E7D32
}
package "Collaboration" as CO {
  rectangle "projects\nworkspaces (manuscript editor)\nrecruitment\ncommunities\nforum" as COB #E8F5E9;line:2E7D32
}
package "Submission and peer review" as RV {
  rectangle "submissions\nreviews" as RVB #E8F5E9;line:2E7D32
}
package "Operations and commerce" as OP {
  rectangle "credits\nnotifications\nadmin\npipeline\nevaluation\nanalytics\naudit\nhome" as OPB #E8F5E9;line:2E7D32
}
WKR -down-> SCB
WKR -down-> AIB
WKR -down-> OPB
WKR -[hidden]right-> COREB
SCB -[hidden]right-> AIB
AIB -right-> OPB : charge and refund
AIB -left-> SCB : retrieval
OPB -[hidden]right-> IDB
IDB -[hidden]right-> COB
OPB -[hidden]down-> RVB
IDB -[hidden]down-> COB
RVB -up-> OPB : notify
RVB -up-> IDB : eligibility
COB -up-> IDB : membership checks
@enduml
