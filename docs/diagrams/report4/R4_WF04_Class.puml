@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF04 Lecturer verification - class diagram
hide empty members
hide circle
package "Web" {
  class LecturerVerificationPage <<page>> {
    lecturer-verification-status
    position-verification-panel
  }
  class AdminVerificationsPage <<page>> {
    pages/admin/academic-verifications.tsx
  }
  class AcademicProfileApi <<api client>> {
    submitLecturerVerification()
    requestVerification()
    verificationStatus()
    listVerifications() admin
    decide() admin
  }
}
package "Backend routes" {
  class academicProfileRouter <<route>> {
    POST /academic-profiles/me/verification-request
    POST /me/verification-evidence
    GET /me/verification-status
  }
  class academicProfileAdminRouter <<route>> {
    GET /admin/academic-verifications
    PATCH /admin/academic-verifications/:requestId
  }
}
package "Services" {
  class academicProfileService <<service>> {
    requestVerification()
    decideVerification()
    updateProfile()
  }
  class lecturerVerificationService <<service>> {
    submitLecturerVerification()
    reviewLecturerEvidence()
  }
  class affiliationVerificationService <<service>> {
    submit() student affiliation document
  }
  class affiliationService <<service>> {
    verifyFromEmail()
    verifyFromInstitutionalEmail()
  }
  class verificationEvidenceStorage <<service>> {
    save()
    adminLocation()
  }
  class verificationEvidenceRetention <<job>> {
    cleanupVerificationEvidence()
  }
  class capabilityService <<service>> {
    evaluate(userId)
    list(userId)
  }
  class notificationService <<service>>
}
package "Data model (Prisma)" {
  class VerificationEvidence <<model>> {
    verification_evidence
    status, revision
    supersededAt, invalidatedAt
  }
  class VerificationEvidenceSource <<model>> {
    verification_evidence_sources
  }
  class AcademicProfile <<model>> {
    academic_profiles
    positionStatus
    roleVerificationStatus
  }
  class Affiliation <<model>> {
    affiliations
  }
  class UserCapability <<model>> {
    user_capabilities
  }
}
LecturerVerificationPage --> AcademicProfileApi
AdminVerificationsPage --> AcademicProfileApi
AcademicProfileApi --> academicProfileRouter : HTTP
AcademicProfileApi --> academicProfileAdminRouter : HTTP
academicProfileRouter --> academicProfileService
academicProfileAdminRouter --> academicProfileService
academicProfileService --> lecturerVerificationService
academicProfileService --> affiliationVerificationService
lecturerVerificationService --> verificationEvidenceStorage
academicProfileService --> capabilityService
academicProfileService --> notificationService
academicProfileService --> VerificationEvidence
academicProfileService --> AcademicProfile
lecturerVerificationService --> VerificationEvidenceSource
affiliationVerificationService --> Affiliation
affiliationService --> VerificationEvidence
capabilityService --> UserCapability
verificationEvidenceRetention --> VerificationEvidence
VerificationEvidence "1" --> "*" VerificationEvidenceSource : request_id
@enduml
