@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF02 Gap analysis and validation - class diagram
hide empty members
hide circle
package "Web" {
  class ResearchGapsPage <<page>> {
    pages/research-gaps.tsx
    gap-analysis-workflow.tsx
    gap-expert-validation.tsx
  }
  class UseGaps <<hook>> {
    useAnalyzeGap()
    useGapAnalysisStatus()
    useRequestGapValidation()
    useAddGapValidation()
  }
  class GapsApi <<api client>> {
    analyze()
    requestValidation()
    addValidation()
  }
}
package "Backend routes" {
  class gapsRouter <<route>> {
    POST /gaps/analyze
    POST /gaps/analyze/:id/retry
    POST /gaps/candidates
    POST /gaps/:id/request-validation
    POST /gaps/:id/validations
  }
  class gapsController <<controller>> {
    analyze()
    retryAnalysis()
    getAnalysis()
  }
}
package "Services" {
  class gapsService <<service>> {
    enqueue(userId, dto)
    retryAnalysis()
    runGapPipeline(job)
    fanOutGapsFromReport(job)
    markAnalysisFailed()
  }
  class gapEvidence <<service>> {
    gap-evidence.ts, gap-mmr.ts
    gap-query-expansion.ts
  }
  class gapValidationService <<service>> {
    createCandidate()
    requestValidation()
    addEvidence()
    addValidation()
    listValidationQueue()
  }
  class gapValidationRules <<rules>> {
    resolveValidationStatus()
    gapValidationConflict()
    canViewGapValidation()
  }
  class capabilityService <<service>> {
    list(userId)
  }
  class creditService <<service>>
}
package "Worker" {
  class gapsWorker <<worker>> {
    workers/gaps.worker.ts
    sweepStuckGapAnalyses()
  }
}
package "Data model (Prisma)" {
  class GapAnalysis <<model>> {
    gap_analyses
    status
  }
  class ResearchGap <<model>> {
    research_gaps
    validationStatus, version
  }
  class GapValidation <<model>> {
    gap_validations
    action, gapVersion
  }
  class GapEvidenceRecord <<model>> {
    gap_evidence_records
  }
  class UserCapability <<model>> {
    user_capabilities
    GAP_VALIDATION
  }
}
ResearchGapsPage --> UseGaps
UseGaps --> GapsApi
GapsApi --> gapsRouter : HTTP
gapsRouter --> gapsController
gapsController --> gapsService
gapsRouter --> gapValidationService
gapsService --> creditService
gapsService --> gapEvidence
gapsService --> GapAnalysis
gapsService --> ResearchGap
gapsWorker --> gapsService
gapValidationService --> gapValidationRules
gapValidationService --> capabilityService
gapValidationService --> ResearchGap
gapValidationService --> GapValidation
gapValidationService --> GapEvidenceRecord
capabilityService --> UserCapability
GapAnalysis "1" --> "*" ResearchGap : analysis_id
ResearchGap "1" --> "*" GapValidation : gap_id
ResearchGap "1" --> "*" GapEvidenceRecord : gap_id
@enduml
