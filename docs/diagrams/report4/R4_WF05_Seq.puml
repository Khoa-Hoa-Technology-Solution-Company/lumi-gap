title WF05 PayOS credit top-up - sequence
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "User" as U
boundary "Web\ncredits tab" as W
control "creditRouter /\ncreditController" as R
control "payosService" as P
participant "PayOS" as PO <<external>>
control "creditService" as C
database "PostgreSQL" as DB
U -> W : choose top-up amount (VND)
W -> R : POST /credits/payos/create-payment-link {amountVnd}
R -> P : createPaymentLink(userId, amountVnd)
activate P
alt amount < MIN_TOPUP_VND (10000) or not a multiple of CREDIT_PRICE_VND (100)
  P --> W : rejected
else valid amount
  P -> PO : POST /v2/payment-requests (HMAC-signed body)
  PO --> P : checkoutUrl, qrCode, paymentLinkId
  P -> DB : insert payment_orders (pending)
  P --> W : checkoutUrl
end
deactivate P
W -> PO : redirect user to checkout
U -> PO : pay by bank transfer or QR
PO -> R : POST /credits/payos/webhook\n(code, data, signature)
R -> P : handleWebhook(body)
activate P
P -> P : verify HMAC signature, code 00
P -> DB : find order by orderCode, check not paid,\namount equals order.amount
P -> C : rewardCreditsOnce(key payos:orderCode)
C -> DB : tx (serializable) users.credits + n,\ninsert credit_transactions (reward, credit_topup)
P -> DB : update payment_orders pending to paid
P --> PO : 200 success
deactivate P
W -> R : GET /credits/balance and /credits/orders\n(refetch on return)
@enduml
