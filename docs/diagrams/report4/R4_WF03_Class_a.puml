title WF03 Submission and AI pre-review - class diagram (a)
hide empty members
hide circle
package "Web" {
  class SubmissionPages <<page>> {
    pages/submissions (list, new, detail)
  }
  class UseSubmissions <<hook>> {
    useCreateSubmission()
    useRunAiPreReview()
  }
}
package "Backend routes" {
  class submissionRouter <<route>> {
    POST /submissions
    POST /submissions/:id/ai-pre-review
    POST /submissions/:id/versions
  }
}
package "Services, worker, clients" {
  class submissionService <<service>> {
    create()
    runAiPreReview()
    processAiPreReview()
    failAiPreReview()
    createVersion()
    addRevision()
  }
  class aiJobsWorker <<worker>> {
    workers/ai-jobs.worker.ts
  }
  class aiReviewerClient <<client>> {
    preReview()
  }
  class aiReviewerService <<external>> {
    Python FastAPI
    /internal/pre-review
  }
}
package "Data model (Prisma)" {
  class Submission <<model>> {
    submissions
  }
  class SubmissionRevision <<model>> {
    submission_revisions
  }
  class AiPreReview <<model>> {
    ai_pre_reviews
  }
}
SubmissionPages ..> UseSubmissions
UseSubmissions ..> submissionRouter : HTTP
submissionRouter ..> submissionService
aiJobsWorker ..> submissionService
submissionService ..> aiReviewerClient
aiReviewerClient ..> aiReviewerService : HTTP
submissionService ..> Submission
submissionService ..> SubmissionRevision
submissionService ..> AiPreReview
Submission "1" -- "1..*" SubmissionRevision
Submission "1" -- "0..*" AiPreReview
@enduml
