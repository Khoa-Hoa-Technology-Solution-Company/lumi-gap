@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF05 Credit top-up - class diagram
hide empty members
skinparam classAttributeIconSize 0
skinparam ClassFontSize 12
package "Web" {
  class CreditHistory <<page>> {
    features/credits/components/credit-history.tsx
    useCreditBalance(), usePaymentOrders()
  }
  class CreditsApi <<api client>> {
    createPaymentLink(amountVnd)
    listOrders()
    getBalance()
  }
}
package "Backend routes" {
  class creditRouter <<route>> {
    POST /credits/payos/create-payment-link
    POST /credits/payos/webhook (public)
    GET /credits/balance, summary, transactions, orders
  }
  class creditController <<controller>> {
    createPaymentLink()
    handlePayosWebhook()
    listOrders()
  }
}
package "Backend services" {
  class payosService <<service>> {
    createPaymentLink(params)
    handleWebhook(body)
    getUserOrders()
    generatePayosSignature()
  }
  class creditService <<service>> {
    rewardCreditsOnce()
    chargeCreditsChecked()
    refundCreditsOnce()
    getSummary()
  }
  class creditPolicy <<service>> {
    credit actions and costs
  }
}
package "Data model (Prisma)" {
  class PaymentOrder <<model>> {
    payment_orders
    orderCode, amount, credits, status
  }
  class CreditTransaction <<model>> {
    credit_transactions
    idempotencyKey, type, status
  }
  class User <<model>> {
    users
    credits
  }
}
class PayOS <<external>> {
  api-merchant.payos.vn
}
CreditHistory --> CreditsApi
CreditsApi --> creditRouter : HTTP
creditRouter --> creditController
creditController --> payosService
payosService --> creditService
payosService --> PayOS : create link
PayOS --> creditRouter : webhook
payosService --> PaymentOrder
creditService --> CreditTransaction
creditService --> User
creditService --> creditPolicy
User "1" --> "*" PaymentOrder
User "1" --> "*" CreditTransaction
@enduml
