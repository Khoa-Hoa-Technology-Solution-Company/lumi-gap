title WF05 Credit top-up - class diagram
hide empty members
hide circle
package "Web" {
  class CreditHistory <<page>> {
    credit-history.tsx
    useCreditBalance(), usePaymentOrders()
    CreditsApi.createPaymentLink()
  }
}
package "Backend" {
  class creditRouter <<route>> {
    POST /credits/payos/create-payment-link
    POST /credits/payos/webhook (public)
    GET /credits/balance, orders
    (creditController)
  }
  class payosService <<service>> {
    createPaymentLink(params)
    handleWebhook(body)
    getUserOrders()
  }
  class creditService <<service>> {
    rewardCreditsOnce()
    chargeCreditsChecked()
    refundCreditsOnce()
  }
}
package "Data model (Prisma)" {
  class PaymentOrder <<model>> {
    payment_orders
    orderCode, amount, status
  }
  class CreditTransaction <<model>> {
    credit_transactions
    idempotencyKey
  }
  class User <<model>> {
    users
    credits
  }
}
class PayOS <<external>> {
  api-merchant.payos.vn
}
CreditHistory ..> creditRouter : HTTP
creditRouter ..> payosService
payosService ..> creditService
payosService ..> PayOS : create link
PayOS ..> creditRouter : webhook
payosService ..> PaymentOrder
creditService ..> CreditTransaction
creditService ..> User
User "1" -- "0..*" PaymentOrder
User "1" -- "0..*" CreditTransaction
@enduml
