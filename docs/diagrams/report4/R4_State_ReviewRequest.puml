@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title ReviewRequest status (review_requests.status)
[*] --> REQUESTED : reviewRequestService.create()
[*] --> ACCEPTED : acceptExternalInvitation()
REQUESTED --> ACCEPTED : accept()
REQUESTED --> DECLINED : decline()
REQUESTED --> CANCELLED : cancel()
REQUESTED --> EXPIRED : expireReviewRequests()\nwhen expiresAt passed
ACCEPTED --> IN_REVIEW : saveReview() draft
ACCEPTED --> COMPLETED : saveReview(submit)\nno revision needed
ACCEPTED --> REVISION_REQUESTED : saveReview(submit)\nrevision needed
IN_REVIEW --> COMPLETED : saveReview(submit)
IN_REVIEW --> REVISION_REQUESTED : saveReview(submit)
ACCEPTED --> DECLINED : decline() withdraw\n(no round submitted)
IN_REVIEW --> DECLINED : decline() withdraw\n(no round submitted)
ACCEPTED --> CANCELLED : cancel()\nonly after deadline
IN_REVIEW --> CANCELLED : cancel()\nonly after deadline
REVISION_REQUESTED --> RESUBMITTED : resubmit()
RESUBMITTED --> IN_REVIEW : saveReview() draft
RESUBMITTED --> COMPLETED : saveReview(submit)
RESUBMITTED --> REVISION_REQUESTED : saveReview(submit)
COMPLETED --> [*]
DECLINED --> [*]
CANCELLED --> [*]
EXPIRED --> [*]
state SUBMITTED #F5F5F5
note right of SUBMITTED
  <b>Dead value</b>: SUBMITTED is in the DB CHECK constraint
  and in ACTIVE_REVIEW_REQUEST_STATUSES but is never
  written by any service.
end note
@enduml
