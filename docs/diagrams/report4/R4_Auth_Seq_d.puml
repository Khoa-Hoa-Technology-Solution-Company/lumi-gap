@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title Authentication (d): Google sign-in completion
boundary "Web app" as W #DCEAFB
control "authRouter" as R #E3F2E5
control "authService" as A #E3F2E5
database "Redis" as RD #EFE6F8
database "PostgreSQL" as DB #EFE6F8
R -> A : googleLogin(identity, ctx)
activate R
A -> DB : find or create users,\noauth_accounts, refresh_tokens
A --> R : AuthResponse
R -> RD : SET exchange code\n(TTL 60 s, NX)
R --> W : 302 {origin}/auth/\noauth-callback?code
deactivate R
W -> R : POST /auth/oauth/exchange\n{code}
activate R
R -> RD : GETDEL exchange code
alt code missing or expired
  R --> W : 401 invalid or expired
else code valid
  R --> W : 200 AuthResponse
end
deactivate R
@enduml
