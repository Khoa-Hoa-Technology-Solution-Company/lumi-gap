@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Literature matrix, limitations and feasibility (projects addendum)
entity project_matrix_criteria #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK projects,UK>>
  created_by_id : uuid <<FK users>>
  ..
  label : varchar(80) <<UK*>>
  description : varchar(500)
  position : integer
  archived_at : timestamptz
  version : integer
}
entity project_evidence_items #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
  project_id : uuid <<UK>>
  criteria_values : jsonb
}
entity project_limitations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK projects,UK>>
  gap_id : uuid <<FK>>
  created_by_id : uuid <<FK users,UK>>
  ..
  statement : text
  category : varchar(24)
  status : varchar(16)
  status_rationale : text
  client_key : uuid <<UK>>
  version : integer
}
entity project_limitation_sources #EFE6F8;line:6A3FA0 {
  * limitation_id : uuid <<PK,FK>>
  * evidence_item_id : uuid <<PK,FK>>
  --
  project_id : uuid <<FK>>
  added_by_id : uuid <<FK users>>
}
entity project_feasibility_assessments #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK projects,UK>>
  assessor_id : uuid <<FK users,UK>>
  ..
  target_kind : varchar(16) <<UK>>
  target_id : uuid <<UK>>
  target_version : integer
  data_availability : smallint
  expertise : smallint
  resources : smallint
  timeline : smallint
  risk : smallint
  notes : text
  version : integer
}
entity research_gaps #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
project_limitations ||--o{ project_limitation_sources
project_evidence_items ||--o{ project_limitation_sources
research_gaps |o--o{ project_limitations
project_limitations .. project_feasibility_assessments : target_kind = LIMITATION
research_gaps .. project_feasibility_assessments : target_kind = GAP
project_matrix_criteria .. project_evidence_items : criteria_values keys
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only). Dotted lines: logical references checked by the service, no FK.
UK*: partial unique index (unique only for rows matching its WHERE condition).
endlegend
@enduml
