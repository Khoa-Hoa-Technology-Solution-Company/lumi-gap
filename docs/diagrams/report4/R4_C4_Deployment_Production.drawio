<mxfile><diagram name="p1"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1040" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:28px&quot;&gt;Deployment diagram (C4): production as defined by the Jenkinsfile&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=28;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1460" height="40" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Jenkins pipeline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[Jenkinsfile, branch main]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;builds images tagged with the 12-char git SHA, validates the env file, docker run, checks /ready&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F1F3;fontColor=#1B2A3A;strokeColor=#8A8F98;fontSize=19;" vertex="1" parent="1"><mxGeometry x="10" y="55" width="1480" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Reverse proxy (Nginx Proxy Manager)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[docker network nginx-network]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;lumigap.uk to web:80 ; api.lumigap.uk to backend:4000&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8A8F98;fontColor=#ffffff;strokeColor=#6B6F77;fontSize=19;" vertex="1" parent="1"><mxGeometry x="10" y="175" width="800" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Network user1-liemresearch" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9DB3CC;dashed=1;dashPattern=8 4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontColor=#444444;fontStyle=1;fontSize=19;" vertex="1" parent="1"><mxGeometry x="10" y="410" width="1480" height="400" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;user1-liemresearch-web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[web image, nginx]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;127.0.0.1:9001 to 80&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1E6FD9;fontColor=#ffffff;strokeColor=#164F9A;fontSize=19;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="420" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;user1-liemresearch-backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[backend image, Node 22]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;127.0.0.1:9000 to 4000&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#ffffff;strokeColor=#1F5A23;fontSize=19;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="420" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;user1-liemresearch-redis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[redis:7-alpine]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;AOF, requirepass, named volume&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#6A3FA0;fontColor=#ffffff;strokeColor=#4C2B75;fontSize=19;" vertex="1" parent="1"><mxGeometry x="1060" y="480" width="410" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;libretranslate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[libretranslate:v1.9.6]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;alias libretranslate, two volumes&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F1F3;fontColor=#1B2A3A;strokeColor=#8A8F98;fontSize=19;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="420" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;user1-liemresearch-worker-* (6 containers)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;[backend image]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;report, gaps, notifications, embedding, paper-analysis, corpus-validation&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E08A00;fontColor=#ffffff;strokeColor=#A86600;fontSize=19;" vertex="1" parent="1"><mxGeometry x="520" y="700" width="950" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Not defined in Jenkinsfile, compose, Dockerfiles or deploy/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:18px&quot;&gt;Staging environment: not defined (one production environment).&lt;br&gt;Production PostgreSQL host: not in the Jenkinsfile (env file from credential lumigap-backend-env-b64).&lt;br&gt;Production ai-reviewer and LaTeX compiler: not deployed by the Jenkinsfile.&lt;br&gt;Hosting provider, server name: not stated.&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0F1F3;fontColor=#1B2A3A;strokeColor=#8A8F98;fontSize=19;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="10" y="850" width="1480" height="170" as="geometry"/></mxCell><mxCell id="c13" value="docker run" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#4A5A6A;fontSize=18;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="lumigap.uk&lt;br&gt;&lt;span style=&quot;font-size:17px&quot;&gt;[HTTPS to :80]&lt;/span&gt;" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#4A5A6A;fontSize=18;fontColor=#333333;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;exitX=0.47;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mx