@startuml
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF01 Create a report - request sequence
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "User" as U
boundary "Web\nreports-list.tsx,\nuseCreateReport" as W
control "reportRouter /\nreportController" as R
control "reportService.create" as S
control "creditService" as C
database "PostgreSQL\n(Prisma)" as DB
queue "BullMQ report queue\n(Redis)" as Q
U -> W : submit question, scope, options
W -> R : POST /api/v1/reports (JWT)
R -> R : requireAuth, requireResearchWorkflow,\ncreateReportLimiter
R -> S : create(userId, input)
activate S
S -> DB : count queued or recent generating reports
alt pending count >= REPORT_MAX_PENDING_PER_USER
  S --> R : 429 too many
end
S -> C : chargeCreditsChecked(idempotencyKey report:id)
C -> DB : tx decrement users.credits,\ninsert credit_transactions (charge, applied)
S -> DB : tx insert reports (queued, DRAFT),\nreport_papers (selected), project_activities
S -> Q : add generate-report (jobId = report id)
alt DB or enqueue error
  S -> C : refundCreditsOnce()
end
S --> R : id, status queued
deactivate S
R --> W : 201
loop every 3 s while queued or generating
  W -> R : GET /reports/:id
end
@enduml
