@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Mentoring support (9 of 9)
entity mentor_suggestions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  mentor_user_id : uuid <<FK users>>
  suggested_by : uuid <<FK users>>
  request_id : uuid <<FK>>
  resolved_by : uuid <<FK users>>
  ..
  message : varchar(1000)
  status : varchar(24)
}
entity mentorship_attachments #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  uploaded_by_id : uuid <<FK users>>
  ..
  file_name : varchar(180)
  mime_type : varchar(100)
}
entity mentorship_request_attachments #EFE6F8;line:6A3FA0 {
  * request_id : uuid <<PK,FK>>
  * attachment_id : uuid <<PK,FK>>
  --
}
entity mentorship_drafts #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  user_id : uuid <<FK users>>
  ..
  direction : varchar(32)
  mentor_role : varchar(16)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity mentorship_requests #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
mentorship_attachments ||--o{ mentorship_request_attachments
mentorship_requests |o--o{ mentor_suggestions
mentorship_requests ||--o{ mentorship_request_attachments
projects ||--o{ mentor_suggestions
projects ||--o{ mentorship_attachments
projects ||--o{ mentorship_drafts
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
