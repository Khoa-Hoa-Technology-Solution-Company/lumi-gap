@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - External review invitations (7 of 7)
entity external_review_invitations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  invited_user_id : uuid <<FK users>>
  requester_id : uuid <<FK users>>
  submission_id : uuid <<FK>>
  project_id : uuid <<FK>>
  template_version_id : uuid <<FK>>
  artifact_revision_id : uuid <<FK>>
  token_hash : varchar(128) <<UK>>
  ..
  reviewer_email : varchar(320)
  status : varchar(24)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity submissions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity submission_revisions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity review_template_versions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
projects ||--o{ external_review_invitations
review_template_versions ||--o{ external_review_invitations
submission_revisions ||--o{ external_review_invitations
submissions ||--o{ external_review_invitations
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
