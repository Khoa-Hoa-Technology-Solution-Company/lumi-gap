@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Mentorship, recruitment and evidence (2 of 3)
entity mentorship_requests #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  mentor_user_id : uuid <<FK users>>
  requested_by : uuid <<FK users>>
  ..
  mentor_role : varchar(16)
  status : varchar(24)
}
entity mentor_relationships #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  mentor_user_id : uuid <<FK users>>
  source_request_id : uuid <<FK,UK>>
  ..
  mentor_role : varchar(16)
  status : varchar(24)
}
entity recruitment_openings #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  title : varchar(180)
  status : varchar(16)
}
entity recruitment_applications #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  opening_id : uuid <<FK>>
  project_id : uuid <<FK>>
  applicant_id : uuid <<FK users>>
  decided_by_id : uuid <<FK users>>
  ..
  cover_letter : text
  status : varchar(24)
}
entity project_screening_decisions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  paper_id : uuid <<FK project_papers>>
  reviewer_id : uuid <<FK users>>
  ..
  phase : varchar(24)
  decision : varchar(24)
}
entity project_evidence_items #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  paper_id : uuid <<FK project_papers>>
  reviewed_by_id : uuid <<FK users>>
  extracted_by_id : uuid <<FK users>>
  ..
  claim : text
  quotation : text
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
mentorship_requests ||--o| mentor_relationships
papers ||--o{ project_evidence_items
papers ||--o{ project_screening_decisions
projects ||--o{ mentor_relationships
projects ||--o{ mentorship_requests
projects ||--o{ project_evidence_items
projects ||--o{ project_screening_decisions
projects ||--o{ recruitment_applications
projects ||--o{ recruitment_openings
recruitment_openings ||--o{ recruitment_applications
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
