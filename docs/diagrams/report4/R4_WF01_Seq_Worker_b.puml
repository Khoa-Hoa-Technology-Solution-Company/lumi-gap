@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF01 Report worker (b): generate, persist, notify
control "report.worker" as K <<worker>> #FFF1DC
control "ragService" as P #E3F2E5
database "PostgreSQL" as DB #EFE6F8
participant "llmRun\n(Gemini)" as L <<external>> #F0F1F3
control "gapsService" as G #E3F2E5
control "notification\nService" as N #E3F2E5
K -> P : (evidence found)
activate P
P -> L : cachedGenerate(prompt)
L --> P : markdown + gaps\n(or cache hit)
P -> P : check citations, grounding
alt citations invalid or LLM error
  P --> K : throw (BullMQ retries, then\nmarkReportFailed + refund)
else valid
  P -> DB : tx: reports status ready,\nreplace report_papers
  opt cache hit
    P -> DB : refundCreditsOnce
  end
  P -> DB : insert rag_queries,\nrag_query_results
  P -> N : create(report_ready)
  P ->> G : enqueueReportGapFanout\n(gaps queue)
end
P --> K : done
deactivate P
@enduml
