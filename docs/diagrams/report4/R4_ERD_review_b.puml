@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Review requests and assignments (2 of 7)
entity review_requests #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  submission_id : uuid <<FK>>
  project_id : uuid <<FK>>
  requester_id : uuid <<FK users>>
  template_version_id : uuid <<FK>>
  artifact_revision_id : uuid <<FK>>
  ..
  status : varchar(24)
  origin : varchar(32)
}
entity reviewer_assignments #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  submission_id : uuid <<FK>>
  review_request_id : uuid <<FK,UK>>
  artifact_revision_id : uuid <<FK>>
  reviewer_id : uuid <<FK users>>
  assigned_by_id : uuid <<FK users>>
  anonymous_code : text <<UK>>
  ..
  status : varchar(24)
  decision : varchar(24)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity submissions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity submission_revisions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity review_template_versions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
projects ||--o{ review_requests
review_requests |o--o| reviewer_assignments
review_template_versions ||--o{ review_requests
submission_revisions ||--o{ review_requests
submission_revisions |o--o{ reviewer_assignments
submissions ||--o{ review_requests
submissions ||--o{ reviewer_assignments
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
