imary key, FK foreign key, UK unique key." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="159.05" y="661.16" width="489.6" height="15.6" as="geometry"/></mxCell><mxCell id="c148" value="FK &amp;lt;name&amp;gt;: the foreign key references a table that is not drawn here." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="159.05" y="677.12" width="496.8" height="15.6" as="geometry"/></mxCell><mxCell id="c149" value="Dashed boxes belong to another diagram (key only)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="159.05" y="693.09" width="360.0" height="15.6" as="geometry"/></mxCell><mxCell id="c150" value="UK*: partial unique index (unique only for rows matching its WHERE condition)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="159.05" y="709.05" width="561.6" height="15.6" as="geometry"/></mxCell><mxCell id="c151" value="moderation_appeals, copyright_claims and forum_restrictions have no FK constraint in" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="159.05" y="725.01" width="604.8" height="15.6" as="geometry"/></mxCell><mxCell id="c152" value="the final schema (plain reference columns such as moderation_action_id," style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="168.91" y="740.97" width="511.2" height="15.6" as="geometry"/></mxCell><mxCell id="c153" value="target_type/target_id, user_id), so no relation is drawn for them." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;fontSize=12.0;fontFamily=Segoe UI;fontStyle=0;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="168.91" y="756.93" width="475.2" height="15.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>