@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title ContentReport status (content_reports.status)
[*] --> open : report()\nnormal reporter
[*] --> escalated : report()\ncopyright concern or staff author
open --> claimed : forumModerationService.claim()
escalated --> claimed : claim() (admin)
claimed --> claimed : claim()\nrenew or lease expired
open --> resolved : applyAction() /\nreviewReport()
claimed --> resolved : applyAction() /\nreviewReport()
open --> dismissed : DISMISS_REPORT
claimed --> dismissed : DISMISS_REPORT
claimed --> escalated : ESCALATE_REPORT
open --> escalated : ESCALATE_REPORT
claimed --> reviewed : reviewReport()\nstatus reviewed
escalated --> resolved : admin action
escalated --> dismissed : admin action
resolved --> [*]
dismissed --> [*]
reviewed --> [*]
state under_review #F5F5F5
note right of under_review
  <b>Dead value</b>: under_review is accepted by the claim()
  filter and the list API but is never written.
end note
@enduml
