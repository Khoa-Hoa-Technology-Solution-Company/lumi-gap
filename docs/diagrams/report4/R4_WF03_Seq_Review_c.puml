@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF03 Peer review (c): review round
actor "Lecturer" as V
boundary "Web app" as W #DCEAFB
control "reviewService" as RV #E3F2E5
control "peerReview\nAccess" as PA #E3F2E5
database "PostgreSQL" as DB #EFE6F8
control "notification\nService" as N #E3F2E5
V -> W : write review (draft)
W -> RV : POST /reviews/:assignmentId
RV -> DB : upsert human_reviews,\nreview_responses,\nreview_revision_items
RV -> DB : request IN_REVIEW
RV --> W : draft saved
V -> W : submit review
W -> RV : POST /reviews/:assignmentId/\nsubmit
activate RV
RV -> DB : upsert review; request COMPLETED\nor REVISION_REQUESTED, assignment\ncompleted or accepted
RV -> PA : refreshSubmission-\nReviewStatus
RV ->> N : notify requester
RV --> W : 200 review
deactivate RV
@enduml
