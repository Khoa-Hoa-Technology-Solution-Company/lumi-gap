@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam entity<<ref>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
  FontStyle bold
}
skinparam rectangle {
  FontSize 12
}
skinparam ArrowFontSize 12
skinparam ArrowFontColor #1B2A3A
title Web client package structure (apps/web/src)
package "Application shell" as SHELL {
  rectangle "main.tsx / App.tsx" as A1 #EAF2FB
  rectangle "routes (app-routes.tsx)" as A2 #EAF2FB
  rectangle "layouts" as A3 #EAF2FB
  rectangle "pages (route components)" as A4 #EAF2FB
  rectangle "components (shared UI, shadcn-style)" as A5 #EAF2FB
}
package "features (apps/web/src/features)" as FEAT {
  rectangle "auth, academic-profile, user-ai, admin\nsearch, trends, papers, compare, literature, bookmarks, docs, home\nreports, gaps, gap-closure\nprojects, manuscripts, contributions\nsubmissions, reviews\nforum, notifications, analytics, credits" as C1 #E8F5E9;line:2E7D32
}
package "Shared services" as SVC {
  rectangle "services\n(api-client.ts, query-client.ts, confirmation.ts)" as B1 #F3E5F5;line:7B1FA2
  rectangle "stores (Zustand)" as B2 #F3E5F5;line:7B1FA2
  rectangle "hooks, utils, constants, i18n, theme" as B3 #F3E5F5;line:7B1FA2
}
rectangle "@trend/shared-types\n(packages/shared-types)" as EXT #FFF4E5;line:E08A00
rectangle "Backend API" as API #FDECEA;line:C62828
A1 -down-> A2
A2 -down-> A4
A4 -right-> A3
A4 -left-> A5
A4 -down-> C1
C1 -down-> B1
C1 -down-> B2
C1 -down-> B3
C1 -right-> EXT
B1 -down-> API : axios, /api/v1
B1 -[hidden]right-> B2
B2 -[hidden]right-> B3
@enduml
