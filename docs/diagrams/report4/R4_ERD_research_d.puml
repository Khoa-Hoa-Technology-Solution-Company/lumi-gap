@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Gap closure documents, calibration and coverage (4 of 7)
entity gap_closure_documents #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  check_id : uuid <<FK>>
  paper_id : uuid <<FK>>
  reviewer_id : uuid <<FK users>>
  second_reviewer_id : uuid <<FK users>>
  ..
  doi : text
  title : text
}
entity closure_calibrations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  created_by_id : uuid <<FK users>>
  ..
  name : varchar(200)
  judge_kind : varchar(16)
}
entity calibration_questions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  calibration_id : uuid <<FK>>
  closure_check_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  question : text
  witness_doi : text
}
entity coverage_checks #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  topic : varchar(300)
  normalized_topic : varchar(300)
}
entity coverage_check_items #EFE6F8;line:6A3FA0 {
  * coverage_check_id : uuid <<PK,FK>>
  * doi : text <<PK>>
  --
  paper_id : uuid <<FK>>
  ..
  position : integer
  title : text
}
entity gap_closure_checks #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
closure_calibrations ||--o{ calibration_questions
closure_calibrations |o--o{ gap_closure_checks
coverage_checks ||--o{ coverage_check_items
coverage_checks |o--o{ gap_closure_checks
gap_closure_checks |o--o{ calibration_questions
gap_closure_checks ||--o{ gap_closure_documents : check_id
gap_closure_documents |o--o{ gap_closure_checks : witness_document_id
papers |o--o{ coverage_check_items
papers |o--o{ gap_closure_documents
projects |o--o{ coverage_checks
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
