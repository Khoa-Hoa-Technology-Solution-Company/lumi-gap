@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF02 Expert validation (a): request validation
actor "Gap owner" as O
boundary "Web app" as W #DCEAFB
control "gapsRouter" as R #E3F2E5
control "gapValidation\nService" as V #E3F2E5
database "PostgreSQL" as DB #EFE6F8
O -> W : request expert validation
W -> R : POST /gaps/:id/request-validation
R -> V : requestValidation(gapId, userId)
activate V
V -> DB : record gap packet, status to\nUNDER_VALIDATION (from CANDIDATE\nor REFINED)
alt gap not in an eligible status
  V --> R : AppError 409
  R --> W : 409 Conflict
else accepted
  V --> R : updated gap
  R --> W : 200 gap
end
deactivate V
@enduml
