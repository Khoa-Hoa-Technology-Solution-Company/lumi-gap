@startuml
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
title WF02 Gap analysis - sequence
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "User" as U
boundary "Web\ngap-analysis-workflow,\nuseAnalyzeGap" as W
control "gapsRouter /\ngapsController" as R
control "gapsService" as S
control "creditService" as C
database "PostgreSQL" as DB
queue "BullMQ gaps queue" as Q
control "gaps.worker.ts" as K <<worker>>
participant "Gemini via llmRun" as L <<external>>
U -> W : topic, years, evidence mode
W -> R : POST /gaps/analyze
R -> S : enqueue(userId, dto)
activate S
S -> C : chargeCreditsChecked(generate_gaps, 30)
S -> DB : tx insert gap_analyses (queued),\ngap_analysis_papers
S -> Q : add gap-analysis (jobId = analysis id)
S --> W : analysisId
deactivate S
loop poll
  W -> R : GET /gaps/analyze/:id
end
Q -> K : job
K -> S : runGapPipeline(job)
activate S
S -> DB : claim status queued to analyzing
S -> DB : collectGapEvidence\n(vector search, MMR diversification)
S -> L : cachedGenerateJSON(gap prompt)
L --> S : candidate gaps with probes
S -> DB : corpus probe counts,\npossible counter papers
S -> DB : tx insert research_gaps (CANDIDATE),\nresearch_gap_papers, status ready
deactivate S
alt failure after retries
  K -> S : markAnalysisFailed() refunds credits
end
@enduml
