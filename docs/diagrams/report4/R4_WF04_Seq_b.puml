title WF04 Lecturer verification - admin decision (part b)
skinparam maxMessageSize 170
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
autonumber
actor "Administrator" as AD
boundary "Web\nlecturer-verification-status,\nadmin page" as W
control "academicProfile\nRouter" as R
control "academicProfile\nService" as P
control "lecturerVerification\nService" as LV
participant "verificationEvidence\nStorage" as ST
database "PostgreSQL" as DB
control "capability\nService" as C
control "notification\nService" as N
AD -> W : open queue and evidence
W -> R : GET /admin/academic-verifications, evidence file
AD -> W : decision approve, more_info or reject
W -> R : PATCH /admin/academic-verifications/:requestId
R -> P : decideVerification(requestId, input, adminId)
activate P
P -> DB : tx lock users, re-check profile unchanged
P -> LV : reviewLecturerEvidence() per source\n(VALID, INVALID, INCONCLUSIVE)
P -> DB : update evidence PENDING to VERIFIED,\nNEEDS_MORE_INFORMATION or REJECTED
P -> DB : update academic_profiles and affiliations statuses
P -> C : evaluate(userId) re-applies policyCapabilities\n(REVIEW_ARTIFACT, STRUCTURED_REVIEW,\nMENTOR_PROJECT for a verified lecturer)
P -> N : notify lecturer
P --> W : updated profile
deactivate P
@enduml
