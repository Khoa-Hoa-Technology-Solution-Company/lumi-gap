@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF04 Lecturer verification (b): submit request
boundary "Web app" as W #DCEAFB
control "academicProfile\nRouter" as R #E3F2E5
control "academicProfile\nService" as P #E3F2E5
control "lecturer\nVerification\nService" as LV #E3F2E5
database "PostgreSQL" as DB #EFE6F8
control "notification\nService" as N #E3F2E5
W -> R : POST /academic-profiles/me/\nverification-request
activate R
R -> P : requestVerification\n(userId, input)
P -> LV : submitLecturer-\nVerification()
activate LV
LV -> DB : tx: lock user,\ncheck for PENDING
alt a PENDING request already exists
  LV --> R : AppError 409
  R --> W : 409 Conflict
else none
  LV -> DB : supersede NEEDS_MORE_INFO,\ninsert verification_evidence\n(PENDING) and sources,\nprofile PENDING
  LV ->> N : LECTURER_VERIFICATION\n_SUBMITTED
  LV --> R : request
  R --> W : 201 PENDING
end
deactivate LV
deactivate R
@enduml
