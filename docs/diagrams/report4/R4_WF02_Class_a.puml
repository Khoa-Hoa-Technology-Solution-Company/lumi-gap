@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam classAttributeIconSize 0
skinparam ClassFontSize 12
skinparam ClassAttributeFontSize 12
skinparam nodesep 25
skinparam ranksep 40
skinparam class<<page>> { 
  BackgroundColor #DCEAFB
}
skinparam class<<hook>> {
  BackgroundColor #DCEAFB
}
skinparam class<<api client>> {
  BackgroundColor #DCEAFB
}
skinparam class<<route>> {
  BackgroundColor #E3F2E5
}
skinparam class<<controller>> {
  BackgroundColor #E3F2E5
}
skinparam class<<service>> {
  BackgroundColor #E3F2E5
}
skinparam class<<rules>> {
  BackgroundColor #E3F2E5
}
skinparam class<<client>> {
  BackgroundColor #F0F1F3
}
skinparam class<<worker>> {
  BackgroundColor #FFF1DC
}
skinparam class<<job>> {
  BackgroundColor #FFF1DC
}
skinparam class<<model>> {
  BackgroundColor #EFE6F8
}
skinparam class<<external>> {
  BackgroundColor #F0F1F3
}
title WF02 Gap analysis - class diagram (a) analysis pipeline
hide empty members
hide circle
package "Web" {
  class GapAnalysisUi <<page>> {
    gap-analysis-workflow.tsx
    useAnalyzeGap(), useGapAnalysisStatus()
    GapsApi.analyze()
  }
}
package "Backend" {
  class gapsRouter <<route>> {
    POST /gaps/analyze
    POST /gaps/analyze/:id/retry
  }
  class gapsController <<controller>> {
    analyze(), retryAnalysis()
    getAnalysis()
  }
  class gapsService <<service>> {
    enqueue(userId, dto)
    retryAnalysis()
    runGapPipeline(job)
    fanOutGapsFromReport(job)
    markAnalysisFailed()
  }
  class gapEvidence <<service>> {
    gap-evidence.ts, gap-mmr.ts
  }
  class creditService <<service>> {
    chargeCreditsChecked()
    refundCreditsOnce()
  }
  class gapsWorker <<worker>> {
    workers/gaps.worker.ts
    sweepStuckGapAnalyses()
  }
}
package "Data model (Prisma)" {
  class GapAnalysis <<model>> {
    gap_analyses
  }
  class ResearchGap <<model>> {
    research_gaps
  }
}
GapAnalysisUi ..> gapsRouter : HTTP
gapsRouter ..> gapsController
gapsController ..> gapsService
gapsWorker ..> gapsService
gapsService ..> creditService
gapsService ..> gapEvidence
gapsService ..> GapAnalysis
gapsService ..> ResearchGap
GapAnalysis "0..1" -- "0..*" ResearchGap : analysis_id
@enduml
