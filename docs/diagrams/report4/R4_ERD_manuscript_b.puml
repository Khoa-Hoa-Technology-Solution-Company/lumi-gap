@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Manuscript snapshots, compilation and GitHub (2 of 3)
entity manuscript_snapshots #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  workspace_id : uuid <<FK>>
  project_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  label : varchar(160)
  source_version : integer
}
entity manuscript_snapshot_assets #EFE6F8;line:6A3FA0 {
  * snapshot_id : uuid <<PK,FK>>
  * file_id : uuid <<PK,FK>>
  --
}
entity manuscript_compilations #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  snapshot_id : uuid <<FK>>
  requested_by_id : uuid <<FK users>>
  ..
  tex_live_version : varchar(4)
  status : varchar(24)
}
entity manuscript_remote_bindings #EFE6F8;line:6A3FA0 {
  * workspace_id : uuid <<PK,FK>>
  --
  updated_by_id : uuid <<FK users>>
  ..
  repository : varchar(201)
  branch : varchar(200)
}
entity github_connections #EFE6F8;line:6A3FA0 {
  * user_id : uuid <<PK,FK users>>
  --
  github_user_id : varchar(32)
  login : varchar(100)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity draft_workspaces #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity manuscript_files #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
draft_workspaces ||--o| manuscript_remote_bindings
draft_workspaces ||--o{ manuscript_snapshots
manuscript_files ||--o{ manuscript_snapshot_assets
manuscript_snapshots ||--o{ manuscript_compilations
manuscript_snapshots ||--o{ manuscript_snapshot_assets
projects ||--o{ manuscript_snapshots
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
