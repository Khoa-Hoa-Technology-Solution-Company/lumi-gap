@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF03 Submission (c): AI pre-review worker
queue "BullMQ\nai-jobs queue" as Q #EFE6F8
control "ai-jobs.worker" as K <<worker>> #FFF1DC
control "submission\nService" as S #E3F2E5
database "PostgreSQL" as DB #EFE6F8
participant "ai-reviewer\n(FastAPI)" as AI <<external>> #F0F1F3
Q ->> K : deliver job submission-pre-review
activate K
K -> S : processAiPreReview(job)
activate S
S -> DB : claim: QUEUED to PROCESSING
alt submission closed before the run
  S -> DB : ai_pre_reviews CANCELLED
else open
  S -> AI : aiReviewerClient.preReview\n(metadata, text, related papers)
  alt service error
    AI --> S : error
    S --> K : throw (BullMQ retries)
    note right of K : retries exhausted:\nfailAiPreReview() sets FAILED
  else success
    AI --> S : structured analysis
    S -> DB : tx: ai_pre_reviews COMPLETED,\nsubmissions to ready_for_review
  end
end
S --> K : done
deactivate S
K --> Q : job completed or failed
deactivate K
@enduml
