@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Academic profile evidence, external identities and featured works (7 of 7)
entity academic_verification_evidence #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  profile_id : uuid <<FK>>
  ..
  type : varchar(64)
  status : varchar(24)
}
entity academic_external_identities #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  profile_id : uuid <<FK>>
  ..
  provider : varchar(40)
  status : varchar(24)
}
entity academic_featured_works #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  profile_id : uuid <<FK>>
  paper_id : uuid <<FK>>
  ..
  kind : varchar(32)
  doi : text
}
entity academic_profiles #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
academic_profiles ||--o{ academic_external_identities
academic_profiles ||--o{ academic_featured_works
academic_profiles ||--o{ academic_verification_evidence
papers |o--o{ academic_featured_works
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
