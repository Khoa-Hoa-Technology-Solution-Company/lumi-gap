@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Reports and retrieval (1 of 3)
entity reports #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK users>>
  project_id : uuid <<FK>>
  credit_transaction_id : uuid <<FK>>
  ..
  title : varchar(240)
  status : varchar(24)
}
entity report_papers #EFE6F8;line:6A3FA0 {
  * report_id : uuid <<PK,FK>>
  * paper_id : uuid <<PK,FK>>
  * kind : varchar(16) <<PK>>
  --
  position : integer
}
entity rag_queries #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  report_id : uuid <<FK>>
  user_id : uuid <<FK users>>
  ..
  query_text : text
  top_k : integer
}
entity rag_query_results #EFE6F8;line:6A3FA0 {
  * query_id : uuid <<PK,FK>>
  * paper_id : uuid <<PK,FK>>
  --
  score : double precision
  rank : integer
}
entity bookmarks #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK users>>
  paper_id : uuid <<FK>>
  report_id : uuid <<FK>>
  ..
  note : varchar(500)
}
entity papers #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity credit_transactions #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
credit_transactions |o--o{ reports
papers |o--o{ bookmarks
papers ||--o{ rag_query_results
papers ||--o{ report_papers
projects |o--o{ reports
rag_queries ||--o{ rag_query_results
reports |o--o{ bookmarks
reports ||--o{ rag_queries
reports ||--o{ report_papers
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
