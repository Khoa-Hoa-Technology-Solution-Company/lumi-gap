title WF03 Peer review - class diagram (b) review request
hide empty members
hide circle
package "Web" {
  class ReviewPages <<page>> {
    pages/reviews (request-detail)
    useCreateReviewRequest()
    useReviewRequestAction()
  }
}
package "Backend" {
  class reviewRequestRouter <<route>> {
    POST /review-requests
    POST /:id/accept, decline,\ncancel, resubmit
  }
  class reviewRequestService <<service>> {
    create(), accept(), decline()
    cancel(), resubmit()
    acceptExternalInvitation()
  }
  class peerReviewAccess <<service>> {
    assertPeerReviewer()
    assertReviewAdmission()
    refreshSubmissionReviewStatus()
  }
  class academicReviewRules <<rules>> {
    canCancelReviewRequest()
    submissionReviewStatus()
  }
  class notificationService <<service>>
}
package "Data model (Prisma)" {
  class Submission <<model>> {
    submissions
  }
  class ReviewRequest <<model>> {
    review_requests
  }
  class ReviewerAssignment <<model>> {
    reviewer_assignments
  }
}
ReviewPages ..> reviewRequestRouter : HTTP
reviewRequestRouter ..> reviewRequestService
reviewRequestService ..> peerReviewAccess
reviewRequestService ..> academicReviewRules
reviewRequestService ..> notificationService
reviewRequestService ..> ReviewRequest
reviewRequestService ..> ReviewerAssignment
Submission "1" -- "0..*" ReviewRequest
ReviewRequest "1" -- "0..1" ReviewerAssignment
@enduml
