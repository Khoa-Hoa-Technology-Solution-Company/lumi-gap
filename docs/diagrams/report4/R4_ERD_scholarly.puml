@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam entity<<ref>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam linetype ortho
hide circle
title Scholarly corpus (ERD)
entity papers #F7FAFD {
  * id : uuid <<PK>>
  --
  journal_id : uuid <<FK>>
  requested_by_id : uuid <<FK>>
  uploaded_by_id : uuid <<FK>>
  doi : string <<UK>>
  openalex_id : string
  title : string
  publication_year : int
}
entity authors #F7FAFD {
  * id : uuid <<PK>>
  --
  openalex_id : string <<UK>>
  orcid : string
  display_name : string
  h_index : int
}
entity paper_authors #F7FAFD {
  * paper_id : uuid <<PK,FK>>
  * position : int <<PK>>
  --
  author_id : uuid <<FK>>
  display_name : string
  is_corresponding : bool
}
entity journals #F7FAFD {
  * id : uuid <<PK>>
  --
  name : string
  publisher : string
  type : string
}
entity research_topics #F7FAFD {
  * id : uuid <<PK>>
  --
  parent_topic_id : uuid <<FK>>
  topic_name : string
  research_field : string
}
entity paper_topics #F7FAFD {
  * paper_id : uuid <<PK,FK>>
  * position : int <<PK>>
  --
  topic_id : uuid <<FK>>
  topic_name : string
  is_primary : bool
  confidence : float
}
entity keywords #F7FAFD {
  * id : uuid <<PK>>
  --
  normalized_name : string <<UK>>
  keyword_name : string
}
entity paper_keywords #F7FAFD {
  * paper_id : uuid <<PK,FK>>
  * position : int <<PK>>
  --
  keyword_id : uuid <<FK>>
  keyword_name : string
  confidence : float
}
entity paper_documents #F7FAFD {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK>>
  status : string
  source_kind : string
  content_hash : string
}
entity paper_chunks #F7FAFD {
  * id : uuid <<PK>>
  --
  document_id : uuid <<FK>>
  position : int
  page_number : int
  content_hash : string
}
entity paper_source_records #F7FAFD {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK>>
  provider_id : uuid <<FK>>
  external_record_id : string
  metadata_hash : string
  fetched_at : timestamptz
}
entity paper_translations #F7FAFD {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK>>
  source_language : string
  target_language : string
  provider : string
}
entity paper_reviews #F7FAFD {
  * id : uuid <<PK>>
  --
  paper_id : uuid <<FK>>
  user_id : uuid <<FK>>
  status : string
  strictness : string
  model : string
}
entity api_providers <<ref>> #F3E5F5 {
  * id : uuid <<PK>>
}
api_providers ||--o{ paper_source_records
authors |o--o{ paper_authors
journals |o--o{ papers
keywords |o--o{ paper_keywords
paper_documents ||--o{ paper_chunks
papers |o--o{ paper_reviews
papers ||--o{ paper_authors
papers ||--o{ paper_keywords
papers ||--o{ paper_source_records
papers ||--o{ paper_topics
papers ||--o{ paper_translations
papers ||--o| paper_documents
research_topics |o--o{ paper_topics
research_topics |o--o{ research_topics : parent_topic_id
legend bottom
Columns such as user_id and *_by_id reference users (not drawn). Purple entities are shown by id only.
endlegend
@enduml
