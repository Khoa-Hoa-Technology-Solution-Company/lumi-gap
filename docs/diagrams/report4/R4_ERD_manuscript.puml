@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam entity<<ref>> {
  BackgroundColor #F3E5F5
  BorderColor #7B1FA2
}
skinparam linetype ortho
hide circle
title Manuscript workspaces (ERD)
entity draft_workspaces #F7FAFD {
  * id : uuid <<PK>>
  --
  created_by_id : uuid <<FK>>
  main_file_id : uuid <<FK>>
  project_id : uuid <<FK>>
  name : string
  writing_mode : string
  compiler_engine : string
}
entity manuscript_files #F7FAFD {
  * id : uuid <<PK>>
  --
  created_by_id : uuid <<FK>>
  workspace_id : uuid <<FK>>
  path : string
  kind : string
  version : int
}
entity manuscript_updates #F7FAFD {
  * id : uuid <<PK>>
  --
  actor_id : uuid <<FK>>
  file_id : uuid <<FK>>
  client_session_id : uuid
  server_sequence : int
  checksum : string
}
entity manuscript_snapshots #F7FAFD {
  * id : uuid <<PK>>
  --
  created_by_id : uuid <<FK>>
  project_id : uuid <<FK>>
  workspace_id : uuid <<FK>>
  label : string
  source_version : int
  checksum : string
}
entity manuscript_compilations #F7FAFD {
  * id : uuid <<PK>>
  --
  requested_by_id : uuid <<FK>>
  snapshot_id : uuid <<FK>>
  tex_live_version : string
  status : string
  checksum : string
}
entity manuscript_suggestions #F7FAFD {
  * id : uuid <<PK>>
  --
  author_id : uuid <<FK>>
  resolved_by_id : uuid <<FK>>
  workspace_id : uuid <<FK>>
  original : string
  replacement : string
  status : string
}
entity manuscript_remote_bindings #F7FAFD {
  * workspace_id : uuid <<PK,FK>>
  --
  updated_by_id : uuid <<FK>>
  repository : string
  branch : string
  head : string
}
entity github_connections #F7FAFD {
  * user_id : uuid <<PK>>
  --
  login : string
  expires_at : timestamptz
  revision : int
}
entity projects <<ref>> #F3E5F5 {
  * id : uuid <<PK>>
}
draft_workspaces ||--o{ manuscript_files
draft_workspaces ||--o{ manuscript_snapshots
draft_workspaces ||--o{ manuscript_suggestions
draft_workspaces ||--o| manuscript_remote_bindings
manuscript_files |o--o{ draft_workspaces
manuscript_files ||--o{ manuscript_updates
manuscript_snapshots ||--o{ manuscript_compilations
projects ||--o{ draft_workspaces
projects ||--o{ manuscript_snapshots
legend bottom
Columns such as user_id and *_by_id reference users (not drawn). Purple entities are shown by id only.
endlegend
@enduml
