}
title Submission status (submissions.status)
[*] --> submitted : submissionService.create()\n/ column default
[*] --> ready_for_review : ensureReportSubmission()\n[artifact from a report]
submitted --> ready_for_review : processAiPreReview()\n[pre-review completed]
submitted --> under_review : [review request created or\nexternal invitation accepted]
ready_for_review --> under_review : reviewRequestService.create()
revised --> under_review : create() or\nacceptExternalInvitation()
under_review --> revision_requested : refreshSubmissionReviewStatus()\n[revision requested]
under_review --> completed : refreshSubmissionReviewStatus()\n[review completed]
under_review --> ready_for_review : refreshSubmissionReviewStatus()\n[declined, cancelled, expired]
revision_requested --> revised : createVersion() or addRevision()
completed --> revised : [new revision, or no review\nof current revision]
ready_for_review --> revised : createVersion() or addRevision()
under_review --> revised : createVersion() or addRevision()
revised --> under_review : resubmit()\n[active request]
legend bottom
  <b>Dead values</b>: accepted, rejected and withdrawn are only checked as closed states
  (read-only guards). No service function sets them.
  Derived statuses come from submissionReviewStatus()
  in academic-review.rules.ts.
endlegend
@enduml
