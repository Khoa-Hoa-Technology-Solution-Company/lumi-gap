  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF05 PayOS credit top-up (b): webhook validation
participant "PayOS" as PO <<external>> #F0F1F3
control "creditRouter" as R #E3F2E5
control "payosService" as P #E3F2E5
database "PostgreSQL" as DB #EFE6F8
PO ->> R : POST /credits/payos/webhook\n(code, data, signature)
activate R
R -> P : handleWebhook(body)
activate P
alt PAYOS_CHECKSUM_KEY set and\nsignature mismatch
  P --> R : AppError 400
  R --> PO : 400
else signature ok, or no key
  alt code is not 00
    P --> R : success false\n(order unchanged)
  else code is 00
    P -> DB : find order by orderCode
    alt order not found or already paid
      P --> R : success (no change)
    else amount differs from order
      P --> R : AppError 400
    else order pending, amount matches
      note over P : continues in (c)
    end
  end
end
deactivate P
deactivate R
@enduml
