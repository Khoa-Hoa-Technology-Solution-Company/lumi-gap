@startuml
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam usecase {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1B2A3A
}
skinparam class {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
  HeaderBackgroundColor #DCE8F6
}
skinparam state {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
}
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
}
skinparam swimlane {
  BorderColor #9DB3CC
  TitleBackgroundColor #DCE8F6
}
skinparam sequence {
  ParticipantBackgroundColor #EAF2FB
  ParticipantBorderColor #2F6DB5
  LifeLineBorderColor #9DB3CC
  GroupBackgroundColor #F4F7FA
}
skinparam package {
  BackgroundColor #F7F9FC
  BorderColor #9DB3CC
}
skinparam note {
  BackgroundColor #FFF9E5
  BorderColor #E0B200
}
skinparam entity {
  BackgroundColor #F7FAFD
  BorderColor #2F6DB5
}
skinparam rectangle {
  BackgroundColor #F7F9FC
  BorderColor #2F6DB5
}
skinparam maxMessageSize 100
skinparam ParticipantPadding 0
skinparam BoxPadding 2
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam SequenceGroupBackgroundColor #F4F7FA
skinparam SequenceDividerBackgroundColor #DCE8F6
skinparam NoteFontSize 12
hide footbox
autonumber
title WF05 PayOS credit top-up (a): create payment link
actor "User" as U
boundary "Web app" as W #DCEAFB
control "creditRouter" as R #E3F2E5
control "payosService" as P #E3F2E5
participant "PayOS" as PO <<external>> #F0F1F3
database "PostgreSQL" as DB #EFE6F8
U -> W : choose top-up amount (VND)
W -> R : POST /credits/payos/\ncreate-payment-link
activate R
R -> P : createPaymentLink(userId, amountVnd)
activate P
alt amount < 10,000 VND or not a multiple of 100
  P --> R : AppError 400
  R --> W : 400 Bad Request
else amount valid
  opt PayOS keys configured
    P -> PO : POST /v2/payment-requests (signed)
    PO --> P : checkoutUrl, qrCode, paymentLinkId
  end
  P -> DB : insert payment_orders (pending)
  P --> R : checkoutUrl, orderCode
  R --> W : 200 checkoutUrl
end
deactivate P
deactivate R
W -> PO : redirect to checkout
@enduml
