@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Forum revision history and views (5 of 5)
entity forum_post_revisions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  post_id : uuid <<FK>>
  edited_by_id : uuid <<FK users>>
  ..
  revision : integer
  title : varchar(240)
}
entity forum_comment_revisions #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  comment_id : uuid <<FK>>
  edited_by_id : uuid <<FK users>>
  ..
  revision : integer
  body : text
}
entity forum_post_views #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  post_id : uuid <<FK>>
  ..
  viewer_key : varchar(160)
  viewed_at : timestamptz
}
entity forum_post_daily_views #EFE6F8;line:6A3FA0 {
  * post_id : uuid <<PK,FK>>
  * day : date <<PK>>
  --
  count : integer
}
entity forum_posts #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
entity forum_comments #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
forum_comments ||--o{ forum_comment_revisions
forum_posts ||--o{ forum_post_daily_views
forum_posts ||--o{ forum_post_revisions
forum_posts ||--o{ forum_post_views
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
