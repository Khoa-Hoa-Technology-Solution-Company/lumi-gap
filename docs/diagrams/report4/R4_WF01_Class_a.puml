title WF01 Generate research report - class diagram (a) request path
hide empty members
hide circle
package "Web" {
  class ReportsUi <<page>> {
    reports-list.tsx
    useCreateReport(), useReport(id)
    ReportsApi.create(), detail()
  }
}
package "Backend" {
  class reportRouter <<route>> {
    POST /reports
    GET /reports/:id
    PATCH /reports/:id/artifact-status
  }
  class reportController <<controller>> {
    create(), getById()
    updateArtifactStatus()
  }
  class reportService <<service>> {
    create(userId, input)
    getById(userId, id)
    updateArtifactStatus()
  }
  class creditService <<service>> {
    chargeCreditsChecked()
    refundCreditsOnce()
  }
  class creditPolicy <<service>> {
    resolveReportCreditCost()
  }
}
package "Data model (Prisma)" {
  class Report <<model>> {
    reports
  }
  class ReportPaper <<model>> {
    report_papers
  }
  class CreditTransaction <<model>> {
    credit_transactions
  }
}
ReportsUi ..> reportRouter : HTTP
reportRouter ..> reportController
reportController ..> reportService
reportService ..> creditService
reportService ..> creditPolicy
reportService ..> Report
reportService ..> ReportPaper
creditService ..> CreditTransaction
Report "1" -- "0..*" ReportPaper
@enduml
