title WF01 Generate research report - class diagram (a) request path
hide empty members
hide circle
package "Web" {
  class ReportsListPage <<page>> {
    pages/reports/reports-list.tsx
  }
  class UseReports <<hook>> {
    useCreateReport()
    useReport(id)
    useReports()
  }
  class ReportsApi <<api client>> {
    create(payload)
    detail(id)
    updateArtifactStatus(id, status)
  }
}
package "Backend routes" {
  class reportRouter <<route>> {
    POST /reports
    GET /reports/:id
    PATCH /reports/:id/artifact-status
  }
  class reportController <<controller>> {
    create()
    getById()
    updateArtifactStatus()
  }
}
package "Services" {
  class reportService <<service>> {
    create(userId, input)
    getById(userId, id)
    updateArtifactStatus()
    -resolveReportEvidenceScope()
  }
  class creditService <<service>> {
    chargeCreditsChecked()
    refundCreditsOnce()
  }
  class creditPolicy <<service>> {
    resolveReportCreditCost()
  }
}
package "Data model (Prisma)" {
  class Report <<model>> {
    reports
    id, userId, projectId
    status, artifactStatus
    markdown, creditTransactionId
  }
  class ReportPaper <<model>> {
    report_papers
  }
  class CreditTransaction <<model>> {
    credit_transactions
  }
}
ReportsListPage --> UseReports
UseReports --> ReportsApi
ReportsApi --> reportRouter : HTTP
reportRouter --> reportController
reportController --> reportService
reportService --> creditService
reportService --> creditPolicy
reportService --> Report
reportService --> ReportPaper
creditService --> CreditTransaction
@enduml
