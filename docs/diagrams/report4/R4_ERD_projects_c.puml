@startuml
!pragma layout elk
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam ArrowFontSize 12
skinparam ArrowFontColor #4A5A6A
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam entity {
  BackgroundColor #EFE6F8
  BorderColor #6A3FA0
}
skinparam legend {
  BackgroundColor #FFF8E1
  BorderColor #C9B36B
  FontSize 12
}
skinparam stereotypeFontSize 10
hide circle
hide empty methods
title Physical ERD - Project tasks and milestones (3 of 3)
entity project_tasks #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  parent_task_id : uuid <<FK>>
  completed_by_id : uuid <<FK users>>
  assignee_id : uuid <<FK users>>
  created_by_id : uuid <<FK users>>
  milestone_id : uuid <<FK>>
  ..
  title : varchar(240)
  status : varchar(24)
}
entity project_milestones #EFE6F8;line:6A3FA0 {
  * id : uuid <<PK>>
  --
  project_id : uuid <<FK>>
  created_by_id : uuid <<FK users>>
  ..
  title : varchar(240)
  status : varchar(24)
}
entity projects #FFFFFF;line:6A3FA0;line.dashed {
  * id : uuid <<PK>>
}
project_milestones |o--o{ project_tasks
project_tasks |o--o{ project_tasks : parent_task_id
projects ||--o{ project_milestones
projects ||--o{ project_tasks
legend bottom
Crow's-foot notation. PK primary key, FK foreign key, UK unique key.
FK <name>: the foreign key references a table that is not drawn here.
Dashed boxes belong to another diagram (key only).
endlegend
@enduml
