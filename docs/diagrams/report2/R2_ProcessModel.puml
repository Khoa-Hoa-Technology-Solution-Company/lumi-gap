@startuml
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
  DiamondBorderColor #E08A00
}
skinparam partition {
  BorderColor #9DB3CC
  BackgroundColor #F7F9FC
}
skinparam ConditionEndStyle hline
skinparam defaultFontSize 12
title Iterative two-week process (6 iterations)
start
:Confirmed kick-off;
repeat
  partition "Build: steps 1-5" #F7F9FC {
    :1 Iteration planning;
    :2 Requirements update;
    :3 Design;
    repeat
      :4 Implementation;
      :5 PR review;
    repeat while (Defects or review changes?) is (yes: step 4) not (no)
  }
  partition "Verify: steps 6-9" #F7F9FC {
    :6 Unit and integration tests;
    :7 System tests;
    :8 Acceptance and demo;
    if (Work accepted?) then (yes)
    else (no)
      :Return work to the backlog (step 1);
    endif
    :9 Retrospective;
  }
repeat while (Next two-week iteration? (6 in total)) is (yes) not (no)
:Supervisor milestone review
(M1 W3, M2 W6, M3 W9, M4 W11, M5 W12);
:Release candidate and final submission;
stop
@enduml
