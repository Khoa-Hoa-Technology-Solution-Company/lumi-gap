@startuml
!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #4A5A6A
skinparam ArrowThickness 1.2
skinparam BorderColor #2F6DB5
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #2F6DB5
  DiamondBackgroundColor #FFF4E5
  DiamondBorderColor #E08A00
}
skinparam partition {
  BorderColor #9DB3CC
  BackgroundColor #F7F9FC
}
skinparam ConditionEndStyle hline
skinparam defaultFontSize 12
title Iterative two-week process (a): build phase, steps 1-5
start
:Confirmed kick-off;
partition "Build: steps 1-5" #F7F9FC {
  :1 Iteration planning;
  :2 Requirements update;
  :3 Design;
  repeat
    :4 Implementation;
    :5 PR review;
  repeat while (Defects or review changes?) is ([yes: step 4]) not ([no])
}
:Continue with the Verify phase (b);
stop
@enduml
