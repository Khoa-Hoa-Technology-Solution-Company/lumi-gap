# Single local environment: copy to .env, or run pnpm setup (node scripts/setup.mjs).
# [BẮT BUỘC] Required: Gemini key and four secrets below. Setup randomizes secrets.
# Passwords must use only A-Z, a-z, 0-9 so URLs need no separate encoded passwords.
# Docker overrides internal hosts and NODE_ENV; native development expands ${...}.
# Docker-only: no Node install needed, JWT keys are generated into a named volume.
# Optional secrets stay empty; production/Jenkins use .env.production.example.

# Core / ports
NODE_ENV=development
API_PORT=4000
PORT=${API_PORT}
WEB_PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:${WEB_PORT}

# Database
POSTGRES_USER=lumi_gap
# [BẮT BUỘC] pnpm setup generates this secret; change before sharing a demo.
POSTGRES_PASSWORD=ChangeMePostgres123456789012345678
POSTGRES_DB=lumi_gap
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/${POSTGRES_DB}
PERSISTENCE_PROVIDER=postgresql

# Redis
# [BẮT BUỘC] pnpm setup generates this secret; change before sharing a demo.
REDIS_PASSWORD=ChangeMeRedis12345678901234567890
REDIS_HOST_PORT=6379
REDIS_URL=redis://default:${REDIS_PASSWORD}@localhost:${REDIS_HOST_PORT}

# Auth / JWT (relative key paths are anchored to apps/backend)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
JWT_ISSUER=lumigap-api
JWT_AUDIENCE=lumigap-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AI / Gemini
# [BẮT BUỘC] Fill in your API key.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# pnpm setup generates this key. Preserve it to decrypt saved personal API keys.
AI_CONNECTION_ENCRYPTION_KEY=
# Optional trusted local gateway origins, comma-separated; public HTTPS endpoints need no allowlist.
AI_ALLOWED_BASE_URLS=
# Local stack: allow HTTP/HTTPS AI gateways on loopback, LAN and private VPN addresses, on any port.
# Disable this when deploying a public server that must not access private gateways.
AI_ALLOW_LOCAL_ENDPOINTS=true
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_DEEP=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_VERSION=1
GEMINI_EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# AI Reviewer
AI_REVIEWER_URL=http://localhost:8001
# [BẮT BUỘC] pnpm setup generates this secret; change before sharing a demo.
INTERNAL_SERVICE_KEY=ChangeMeInternalService123456789012345678
GEMINI_MODEL=${GEMINI_MODEL_FAST}

# Storage
STORAGE_PROVIDER=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL_SECONDS=300
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# [BẮT BUỘC] pnpm setup generates this secret; change before sharing a demo.
ACADEMIC_EMAIL_OTP_SECRET=ChangeMeAcademicOtp123456789012345678

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:${API_PORT}/api/v1/auth/google/callback

# Translation
TRANSLATION_PROVIDER=gemini
LIBRETRANSLATE_URL=http://localhost:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_MAX_PER_HOUR=30
LIBRETRANSLATE_LOAD_ONLY=en,vi,es,fr,de,pt,zh,ja,ko,ru,id

# Academic providers
OPENALEX_MAILTO=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Payment
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
CREDIT_PRICE_VND=100
MIN_TOPUP_VND=10000

# Frontend (only VITE_* is exposed by Vite)
VITE_API_BASE=/api/v1

# Mobile (public URLs only; Android emulator default, use LAN IP for devices)
EXPO_PUBLIC_API_BASE=http://10.0.2.2:4000/api/v1
API_BASE_URL=http://10.0.2.2:4000/api/v1

# Workers / rate limits / policy tuning: defaults in code, no changes needed
MIGRATION_BATCH_SIZE=500
CHAT_MAX_PER_HOUR=40
TEAM_CHAT_MAX_PER_MINUTE=20
CHAT_CONTEXT_PAPERS=12
CHAT_HISTORY_TURNS=6
CHAT_MAX_PROMPT_CHARS=12000
CHAT_CACHE_TTL_SECONDS=604800
CHAT_ABSTRACT_MAX_CHARS=800
FORUM_APPEAL_SUBMISSION_WINDOW_DAYS=14
FORUM_MODERATION_CLAIM_LEASE_MINUTES=30
FORUM_MODERATION_EVIDENCE_RETENTION_DAYS=365
FORUM_AUDIT_METADATA_RETENTION_DAYS=3650
FORUM_MAX_PINNED_THREADS_PER_COMMUNITY=10
FORUM_COPYRIGHT_EMAIL_VERIFICATION_MINUTES=60
FORUM_RATE_LIMIT_UNVERIFIED=10
FORUM_RATE_LIMIT_VERIFIED=60
FORUM_COPYRIGHT_PUBLIC_RATE_LIMIT=3
FORUM_ALLOW_SOLE_ADMIN_APPEAL_REVIEW=false
SYNC_CRON=0 2 * * *
SYNC_BATCH_SIZE=100
SYNC_MAX_PAGES_PER_RUN=10
SYNC_STORE_RAW_METADATA=false
OPENALEX_INGEST_LEASE_SECONDS=180
OPENALEX_INGEST_CONCURRENCY=1
EMBED_CRON=0 3 * * *
EMBED_BATCH_SIZE=100
EMBED_MAX_PAPERS_PER_RUN=1000
PAPER_ANALYSIS_CRON=0 4 * * *
PAPER_ANALYSIS_BATCH_SIZE=25
PAPER_ANALYSIS_MAX_PAPERS_PER_RUN=100
PAPER_ANALYSIS_MAX_OUTPUT_TOKENS=1024
RAG_MAX_CHUNKS=300
RAG_CHUNK_CHARS=2400
RAG_PASSAGES_PER_PAPER=3
REPORT_TOP_K=8
REPORT_MAX_PENDING_PER_USER=2
REPORT_MAX_PER_HOUR=10
REPORT_MAX_OUTPUT_TOKENS=8192
GAPS_TOP_K=10
GAPS_MAX_PER_HOUR=10
GAPS_MAX_OUTPUT_TOKENS=2048
GAP_SCARCE_ABS=5
GAP_SCARCE_PCT=0.02
GAP_PARENT_RISING_MIN=0
COMPARE_MAX_PAPERS=4
COMPARE_PROMPT_VERSION=compare-v2
COMPARE_MAX_PER_HOUR=20
DEEP_ANALYSIS_MAX_TURNS=5
DEEP_ANALYSIS_MAX_OUTPUT_TOKENS=8192
SEARCH_FILTER_POOL=200
RERANK_CANDIDATES=20
RERANK_MAX_PER_HOUR=30
SEMANTIC_SEARCH_MAX_PER_MINUTE=60
QUALITY_EVAL_MAX_PER_HOUR=20
DIRECTIONS_MAX_PER_HOUR=20
SYNC_ADMIN_BYPASS=false
INITIAL_USER_CREDITS=1000

# Deprecated HMAC variables (optional; unused by RS256). Prefer leaving unset.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# Optional standalone AI Reviewer settings (defaults in Python, usually leave unset).
# AI_PROVIDER=gemini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# REVIEW_DB_PATH=/app/data/review_agent.db
# APP_ENV=development
# APP_BASE_URL=http://localhost:8001
# APP_ENCRYPTION_KEY=
# ADMIN_EMAILS=
# ADMIN_GOOGLE_SUBS=
# CAPTCHA_ENABLED=false
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SMTP_PASSWORD=
# STORAGE_MAINTENANCE_ENABLED=true
# SYSTEM_DRIVE_CREDENTIALS_FILE=
# REVIEW_APP_HOST=
# REVIEW_APP_PORT=
# REVIEW_APP_RELOAD=
# SMTP_ENABLED=
# SMTP_SECURITY=
# SMTP_USERNAME=
