# PaperLens backend production environment
# Copy to .env.production, replace every <required-...> value, and never commit
# the resulting private file.

# Runtime
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=https://paperlens.uk

# Core services
MONGODB_URI=<required-mongodb-uri>
MONGODB_VECTOR_INDEX_NAME=paper_vector_index_v2
MIGRATION_SOURCE_MONGODB_URI=
MIGRATION_SOURCE_DATABASE=
REDIS_DEPLOYMENT=self_hosted
REDIS_PASSWORD=<required-redis-password-minimum-32-characters>
REDIS_URL=redis://default:<required-url-encoded-redis-password>@redis:6379

# PDF storage
STORAGE_PROVIDER=r2
R2_ENDPOINT=<required-r2-endpoint>
R2_ACCESS_KEY_ID=<required-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<required-r2-secret-access-key>
R2_BUCKET=<required-r2-bucket>
R2_SIGNED_URL_TTL_SECONDS=300

# Authentication
JWT_ACCESS_SECRET=<required-secret-minimum-32-characters>
JWT_REFRESH_SECRET=<required-different-secret-minimum-32-characters>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google OAuth
GOOGLE_CLIENT_ID=<required-google-client-id>
GOOGLE_CLIENT_SECRET=<required-google-client-secret>
GOOGLE_CALLBACK_URL=https://api.paperlens.uk/api/v1/auth/google/callback

# Gemini and optional Ollama project chat
GEMINI_API_KEY=<required-gemini-api-key>
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# Paper Detail translation
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=
TRANSLATION_TIMEOUT_MS=15000
TRANSLATION_MAX_PER_HOUR=30

# Chat controls
CHAT_MAX_PER_HOUR=40
TEAM_CHAT_MAX_PER_MINUTE=20
CHAT_CONTEXT_PAPERS=12
CHAT_HISTORY_TURNS=6
CHAT_MAX_PROMPT_CHARS=12000
CHAT_CACHE_TTL_SECONDS=604800
CHAT_ABSTRACT_MAX_CHARS=800

# Academic providers
OPENALEX_MAILTO=<operator-email-address>
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=<operator-email-address>

# Scheduled sync and million-scale OpenAlex ingest
SYNC_CRON=0 2 * * *
SYNC_BATCH_SIZE=100
SYNC_MAX_PAGES_PER_RUN=10
SYNC_STORE_RAW_METADATA=false
OPENALEX_INGEST_LEASE_SECONDS=180
OPENALEX_INGEST_CONCURRENCY=1

# Jenkins browser E2E fixture
# Use a dedicated low-privilege account and a stable active paper that has:
# an embedding, an abstract, and a readable PDF.
E2E_USER_EMAIL=<required-e2e-user-email>
E2E_USER_PASSWORD=<required-e2e-user-password>
E2E_PAPER_ID=<required-e2e-paper-id>
E2E_SEARCH_QUERY=<required-e2e-search-query>
E2E_TRANSLATION_LANGUAGE=vi

# Embedding and structured paper analysis workers
EMBED_CRON=0 3 * * *
EMBED_BATCH_SIZE=100
EMBED_MAX_PAPERS_PER_RUN=1000
PAPER_ANALYSIS_CRON=0 4 * * *
PAPER_ANALYSIS_BATCH_SIZE=25
PAPER_ANALYSIS_MAX_PAPERS_PER_RUN=100
PAPER_ANALYSIS_MAX_OUTPUT_TOKENS=1024

# Reports, research gaps, comparison and deep analysis
REPORT_TOP_K=8
REPORT_MAX_PENDING_PER_USER=2
REPORT_MAX_PER_HOUR=10
REPORT_MAX_OUTPUT_TOKENS=8192
GAPS_TOP_K=6
GAPS_MAX_PER_HOUR=10
GAPS_MAX_OUTPUT_TOKENS=2048
GAP_SCARCE_ABS=5
GAP_SCARCE_PCT=0.02
GAP_PARENT_RISING_MIN=0
COMPARE_MAX_PAPERS=4
COMPARE_PROMPT_VERSION=compare-v2
DEEP_ANALYSIS_MAX_TURNS=5
DEEP_ANALYSIS_MAX_OUTPUT_TOKENS=8192

# Search, rerank and on-demand AI rate limits
SEARCH_FILTER_POOL=200
RERANK_CANDIDATES=20
RERANK_MAX_PER_HOUR=30
QUALITY_EVAL_MAX_PER_HOUR=20
DIRECTIONS_MAX_PER_HOUR=20

# Production safety and credits
SYNC_ADMIN_BYPASS=false
INITIAL_USER_CREDITS=1000
