model Project {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  title             String    @db.VarChar(100)
  description       String?
  researchField     String?   @map("research_field") @db.VarChar(200)
  inclusionCriteria String[]  @default([]) @map("inclusion_criteria")
  exclusionCriteria String[]  @default([]) @map("exclusion_criteria")
  status            String    @default("PLANNING") @db.VarChar(24)
  visibility        String    @default("PRIVATE") @db.VarChar(24)
  ownerId           String    @map("owner_id") @db.Uuid
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@index([status, visibility, updatedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("MEMBER") @db.VarChar(24)
  status    String   @default("ACTIVE") @db.VarChar(24)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@map("project_members")
}

model ProjectPaper {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  paperId         String    @map("paper_id") @db.Uuid
  addedById       String?   @map("added_by_id") @db.Uuid
  screeningStatus String    @default("UNDECIDED") @map("screening_status") @db.VarChar(24)
  readingStatus   String    @default("NOT_STARTED") @map("reading_status") @db.VarChar(24)
  inclusionReason String?   @map("inclusion_reason")
  exclusionReason String?   @map("exclusion_reason")
  exclusionNote   String?   @map("exclusion_note")
  screenedById    String?   @map("screened_by_id") @db.Uuid
  screenedAt      DateTime? @map("screened_at") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, paperId])
  @@index([projectId, screeningStatus, readingStatus])
  @@index([paperId])
  @@map("project_papers")
}

model ProjectInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  invitedUserId String?   @map("invited_user_id") @db.Uuid
  email         String    @db.VarChar(320)
  message       String?   @db.VarChar(1000)
  tokenHash     String?   @unique @map("token_hash") @db.VarChar(128)
  purpose       String    @default("PROJECT_MEMBERSHIP") @db.VarChar(48)
  invitedById   String    @map("invited_by_id") @db.Uuid
  status        String    @default("PENDING") @db.VarChar(24)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, createdAt])
  @@index([invitedUserId, status, createdAt])
  @@index([email, status, createdAt])
  @@index([tokenHash])
  @@map("project_invitations")
}

model ProjectActivity {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String   @db.VarChar(48)
  entityKind String?  @map("entity_kind") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@map("project_activities")
}

model MentorRelationship {
