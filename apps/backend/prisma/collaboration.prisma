model Project {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  title             String    @db.VarChar(100)
  description       String?
  researchField     String?   @map("research_field") @db.VarChar(200)
  inclusionCriteria String[]  @default([]) @map("inclusion_criteria")
  exclusionCriteria String[]  @default([]) @map("exclusion_criteria")
  status            String    @default("PLANNING") @db.VarChar(24)
  visibility        String    @default("PRIVATE") @db.VarChar(24)
  ownerId           String    @map("owner_id") @db.Uuid
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId])
  @@index([status, visibility, updatedAt])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("MEMBER") @db.VarChar(24)
  status    String   @default("ACTIVE") @db.VarChar(24)
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@map("project_members")
}

model ProjectPaper {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  paperId         String    @map("paper_id") @db.Uuid
  addedById       String?   @map("added_by_id") @db.Uuid
  screeningStatus String    @default("UNDECIDED") @map("screening_status") @db.VarChar(24)
  readingStatus   String    @default("NOT_STARTED") @map("reading_status") @db.VarChar(24)
  inclusionReason String?   @map("inclusion_reason")
  exclusionReason String?   @map("exclusion_reason")
  exclusionNote   String?   @map("exclusion_note")
  screenedById    String?   @map("screened_by_id") @db.Uuid
  screenedAt      DateTime? @map("screened_at") @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, paperId])
  @@index([projectId, screeningStatus, readingStatus])
  @@index([paperId])
  @@map("project_papers")
}

model ProjectInvitation {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  invitedUserId String?   @map("invited_user_id") @db.Uuid
  email         String    @db.VarChar(320)
  message       String?   @db.VarChar(1000)
  tokenHash     String?   @unique @map("token_hash") @db.VarChar(128)
  purpose       String    @default("PROJECT_MEMBERSHIP") @db.VarChar(48)
  invitedById   String    @map("invited_by_id") @db.Uuid
  status        String    @default("PENDING") @db.VarChar(24)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, createdAt])
  @@index([invitedUserId, status, createdAt])
  @@index([email, status, createdAt])
  @@index([tokenHash])
  @@map("project_invitations")
}

model ProjectActivity {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  type       String   @db.VarChar(48)
  entityKind String?  @map("entity_kind") @db.VarChar(32)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
  @@map("project_activities")
}

model MentorRelationship {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @map("project_id") @db.Uuid
  mentorUserId String    @map("mentor_user_id") @db.Uuid
  requestedBy  String    @map("requested_by") @db.Uuid
  status       String    @default("PENDING") @db.VarChar(24)
  message      String?
  responseNote String?   @map("response_note")
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status, createdAt])
  @@index([mentorUserId, status, createdAt])
  @@index([requestedBy, createdAt])
  @@map("mentor_relationships")
}

model ProjectChatMessage {
  id                  String    @id @default(uuid()) @db.Uuid
  legacyMongoId       String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  projectId           String    @map("project_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  scope               String    @default("private") @db.VarChar(16)
  role                String    @db.VarChar(16)
  content             String
  creditTransactionId String?   @map("credit_transaction_id") @db.Uuid
  creditCost          Int?      @map("credit_cost")
  isPinned            Boolean   @default(false) @map("is_pinned")
  pinnedAt            DateTime? @map("pinned_at") @db.Timestamptz(6)
  pinnedById          String?   @map("pinned_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, userId, createdAt])
  @@index([projectId, scope, createdAt])
  @@map("project_chat_messages")
}

model ProjectChatCitation {
  messageId String @map("message_id") @db.Uuid
  paperId   String @map("paper_id") @db.Uuid
  position  Int

  @@id([messageId, paperId])
  @@index([paperId])
  @@map("project_chat_citations")
}

model ProjectTeamMessage {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  projectId     String    @map("project_id") @db.Uuid
  senderId      String    @map("sender_id") @db.Uuid
  content       String
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedById   String?   @map("deleted_by_id") @db.Uuid
  deleteReason  String?   @map("delete_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([projectId, isDeleted, createdAt])
  @@index([senderId])
  @@map("project_team_messages")
}

model ProjectTeamMessageRead {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  @@id([messageId, userId])
  @@index([userId])
  @@map("project_team_message_reads")
}

model ProjectContributionProposal {
  id                       String    @id @default(uuid()) @db.Uuid
  legacyMongoId            String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  projectId                String    @map("project_id") @db.Uuid
  contributorId            String    @map("contributor_id") @db.Uuid
  roles                    String[]  @default([])
  description              String
  evidence                 String?
  visibility               String    @default("PUBLIC") @db.VarChar(16)
  status                   String    @default("PENDING_CONFIRMATION") @db.VarChar(32)
  confirmationRequiredFrom String    @map("confirmation_required_from") @db.VarChar(16)
  proposedById             String    @map("proposed_by_id") @db.Uuid
  confirmedById            String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt              DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedById             String?   @map("rejected_by_id") @db.Uuid
  rejectedAt               DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason          String?   @map("rejection_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([contributorId, status])
  @@map("project_contribution_proposals")
}

model ProjectContributionHistory {
  id         String   @id @default(uuid()) @db.Uuid
  proposalId String   @map("proposal_id") @db.Uuid
  action     String   @db.VarChar(24)
  actorId    String   @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)

  @@index([proposalId, createdAt])
  @@map("project_contribution_history")
}

model Community {
  id                  String                      @id @default(uuid()) @db.Uuid
  legacyMongoId       String?                     @unique @map("legacy_mongo_id") @db.VarChar(24)
  name                String                      @db.VarChar(120)
  slug                String                      @unique @db.VarChar(120)
  // Forum categories reuse the existing taxonomy and moderator assignments.
  isForumCategory     Boolean                     @default(false) @map("is_forum_category")
  sortOrder           Int                         @default(0) @map("sort_order")
  description         String                      @default("")
  researchField       String?                     @map("research_field") @db.VarChar(160)
  icon                String?                     @db.VarChar(40)
  researchTopics      String[]                    @default([]) @map("research_topics")
  visibility          String                      @default("public") @db.VarChar(16)
  status              String                      @default("ACTIVE") @db.VarChar(16)
  rules               String[]                    @default([])
  ownerId             String                      @map("owner_id") @db.Uuid
  memberCount         Int                         @default(0) @map("member_count")
  threadCount         Int                         @default(0) @map("thread_count")
  reviewNote          String?                     @map("review_note")
  reviewedById        String?                     @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?                   @map("reviewed_at") @db.Timestamptz(6)
  searchDocument      Unsupported("tsvector")?    @map("search_document")
  embedding           Unsupported("vector(768)")?
  embeddingModel      String?                     @map("embedding_model")
  embeddingVersion    String?                     @map("embedding_version")
  embeddingDimensions Int?                        @map("embedding_dimensions")
  embeddingUpdatedAt  DateTime?                   @map("embedding_updated_at") @db.Timestamptz(6)
  createdAt           DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, visibility, updatedAt])
  @@index([isForumCategory, status, sortOrder])
  @@index([ownerId])
  @@index([reviewedById])
  @@map("communities")
}

model CommunityMembership {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  communityId   String    @map("community_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  role          String    @default("member") @db.VarChar(16)
  status        String    @default("active") @db.VarChar(16)
  assignedById  String?   @map("assigned_by_id") @db.Uuid
  assignedAt    DateTime? @map("assigned_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  joinedAt      DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([communityId, userId])
  @@index([communityId, status, role])
  @@index([userId])
  @@map("community_memberships")
}

model ForumPost {
  id                  String    @id @default(uuid()) @db.Uuid
  publicSlug          String?   @unique @map("public_slug") @db.VarChar(280)
  publicSlugAliases   String[]  @default([]) @map("public_slug_aliases")
  legacyMongoId       String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  authorId            String    @map("author_id") @db.Uuid
  communityId         String?   @map("community_id") @db.Uuid
  researchGapId       String?   @map("research_gap_id") @db.Uuid
  linkedPaperId       String?   @map("linked_paper_id") @db.Uuid
  linkedResearchGapId String?   @map("linked_research_gap_id") @db.Uuid
  linkedProjectId     String?   @map("linked_project_id") @db.Uuid
  type                String    @default("DISCUSSION") @db.VarChar(32)
  title               String    @db.VarChar(240)
  body                String
  tags                String[]  @default([])
  status              String    @default("active") @db.VarChar(16)
  visibilityStatus    String    @default("ACTIVE") @map("visibility_status") @db.VarChar(16)
  isLocked            Boolean   @default(false) @map("is_locked")
  moderationVersion   Int       @default(0) @map("moderation_version")
  acceptedCommentId   String?   @map("accepted_comment_id") @db.Uuid
  score               Int       @default(0)
  voteScore           Int       @default(0) @map("vote_score")
  commentCount        Int       @default(0) @map("comment_count")
  viewCount           Int       @default(0) @map("view_count")
  viewsTrackedSince   DateTime  @default(now()) @map("views_tracked_since") @db.Timestamptz(6)
  lastActivityAt      DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  isPinned            Boolean   @default(false) @map("is_pinned")
  pinnedAt            DateTime? @map("pinned_at") @db.Timestamptz(6)
  editedAt            DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions  ForumPostRevision[]
  dailyViews ForumPostDailyView[]

  @@index([communityId, status, isPinned, updatedAt])
  @@index([status, isPinned, lastActivityAt])
  @@index([researchGapId, status, createdAt])
  @@index([type, status, createdAt])
  @@index([tags], type: Gin)
  @@index([publicSlugAliases], type: Gin)
  @@map("forum_posts")
}

model ForumPostPaper {
  postId   String @map("post_id") @db.Uuid
  paperId  String @map("paper_id") @db.Uuid
  position Int

  @@id([postId, paperId])
  @@index([paperId])
  @@map("forum_post_papers")
}

model ForumComment {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  postId            String    @map("post_id") @db.Uuid
  postNumber        Int       @map("post_number")
  authorId          String    @map("author_id") @db.Uuid
  parentCommentId   String?   @map("parent_comment_id") @db.Uuid
  body              String
  status            String    @default("active") @db.VarChar(16)
  visibilityStatus  String    @default("ACTIVE") @map("visibility_status") @db.VarChar(16)
  isLocked          Boolean   @default(false) @map("is_locked")
  moderationVersion Int       @default(0) @map("moderation_version")
  score             Int       @default(0)
  voteScore         Int       @default(0) @map("vote_score")
  editedAt          DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  revisions ForumCommentRevision[]

  @@unique([postId, postNumber])
  @@index([postId, status, createdAt])
  @@index([postId, status, authorId, createdAt])
  @@index([authorId])
  @@map("forum_comments")
}

model ForumReference {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String?  @map("post_id") @db.Uuid
  commentId   String?  @map("comment_id") @db.Uuid
  paperId     String?  @map("paper_id") @db.Uuid
  doi         String?
  url         String?
  title       String?
  authors     String[] @default([])
  year        Int?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  verified    Boolean  @default(false)
  position    Int      @default(0)

  @@index([postId, position])
  @@index([commentId, position])
  @@map("forum_references")
}

model ForumTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("forum_tags")
}

model ForumPostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  @@id([postId, tagId])
  @@index([tagId])
  @@map("forum_post_tags")
}

model ForumPostGap {
  postId String @map("post_id") @db.Uuid
  gapId  String @map("gap_id") @db.Uuid

  @@id([postId, gapId])
  @@index([gapId])
  @@map("forum_post_gaps")
}

model ForumPostProject {
  postId    String @map("post_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  @@id([postId, projectId])
  @@index([projectId])
  @@map("forum_post_projects")
}

model ForumThreadFollow {
  postId            String   @map("post_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  notificationLevel String   @default("WATCHING") @map("notification_level") @db.VarChar(16)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("forum_thread_follows")
}

model ForumModerationAction {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  communityId    String?  @map("community_id") @db.Uuid
  postId         String?  @map("post_id") @db.Uuid
  commentId      String?  @map("comment_id") @db.Uuid
  reportId       String?  @map("report_id") @db.Uuid
  targetType     String?  @map("target_type") @db.VarChar(16)
  targetId       String?  @map("target_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  sourceAppealId String?  @map("source_appeal_id") @db.Uuid
  policyRuleCode String?  @map("policy_rule_code") @db.VarChar(80)
  policyVersion  String?  @map("policy_version") @db.VarChar(40)
  previousState  Json?    @map("previous_state")
  action         String   @db.VarChar(40)
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([communityId, createdAt])
  @@index([postId, createdAt])
  @@index([commentId, createdAt])
  @@map("forum_moderation_actions")
}

model ForumVote {
  id            String   @id @default(uuid()) @db.Uuid
  legacyMongoId String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  postId        String?  @map("post_id") @db.Uuid
  commentId     String?  @map("comment_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  value         Int
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([postId])
  @@index([commentId])
  @@index([userId])
  @@map("forum_votes")
}

// Social forum reactions are deliberately separate from ForumVote and from every
// scholarly evidence model. They are discovery/community signals only.
model ForumReaction {
  id         String   @id @default(uuid()) @db.Uuid
  targetType String   @map("target_type") @db.VarChar(16)
  targetId   String   @map("target_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  reaction   String   @db.VarChar(24)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId, reaction])
  @@index([userId, createdAt])
  @@map("forum_reactions")
}

model ForumPostView {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  viewerKey String   @map("viewer_key") @db.VarChar(160)
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  @@unique([postId, viewerKey])
  @@index([postId, viewedAt])
  @@map("forum_post_views")
}

model ForumPostDailyView {
  postId String    @map("post_id") @db.Uuid
  day    DateTime  @db.Date
  count  Int       @default(0)
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, day])
  @@map("forum_post_daily_views")
}

model ContentReport {
  id                 String    @id @default(uuid()) @db.Uuid
  legacyMongoId      String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  reporterId         String    @map("reporter_id") @db.Uuid
  postId             String?   @map("post_id") @db.Uuid
  commentId          String?   @map("comment_id") @db.Uuid
  communityId        String?   @map("community_id") @db.Uuid
  targetType         String    @default("THREAD") @map("target_type") @db.VarChar(16)
  targetId           String?   @map("target_id") @db.Uuid
  reason             String    @db.VarChar(32)
  description        String?
  status             String    @default("open") @db.VarChar(16)
  reviewedById       String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime? @map("reviewed_at") @db.Timestamptz(6)
  moderationNote     String?   @map("moderation_note")
  assignedToId       String?   @map("assigned_to_id") @db.Uuid
  assignedAt         DateTime? @map("assigned_at") @db.Timestamptz(6)
  claimExpiresAt     DateTime? @map("claim_expires_at") @db.Timestamptz(6)
  reportedRevisionId String?   @map("reported_revision_id") @db.Uuid
  contentSnapshot    Json?     @map("content_snapshot")
  version            Int       @default(0)
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolutionNote     String?   @map("resolution_note")
  escalatedAt        DateTime? @map("escalated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([communityId, status, createdAt])
  @@index([reporterId, status])
  @@index([assignedToId, status, createdAt])
  @@index([targetType, targetId, status])
  @@map("forum_content_reports")
}

model ForumRestriction {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  scope           String    @db.VarChar(16)
  communityId     String?   @map("community_id") @db.Uuid
  restrictionType String    @map("restriction_type") @db.VarChar(24)
  reason          String
  startsAt        DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by") @db.Uuid
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy       String?   @map("revoked_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, restrictionType, startsAt, expiresAt])
  @@index([communityId, restrictionType, startsAt, expiresAt])
  @@map("forum_restrictions")
}

