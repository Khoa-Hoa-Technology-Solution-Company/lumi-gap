  description              String
  evidence                 String?
  visibility               String    @default("PUBLIC") @db.VarChar(16)
  status                   String    @default("PENDING_CONFIRMATION") @db.VarChar(32)
  confirmationRequiredFrom String    @map("confirmation_required_from") @db.VarChar(16)
  proposedById             String    @map("proposed_by_id") @db.Uuid
  confirmedById            String?   @map("confirmed_by_id") @db.Uuid
  confirmedAt              DateTime? @map("confirmed_at") @db.Timestamptz(6)
  rejectedById             String?   @map("rejected_by_id") @db.Uuid
  rejectedAt               DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason          String?   @map("rejection_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([contributorId, status])
  @@map("project_contribution_proposals")
}

