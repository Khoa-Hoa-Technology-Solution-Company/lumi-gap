  claimantEmail              String    @map("claimant_email") @db.VarChar(320)
  claimantOrganization       String?   @map("claimant_organization") @db.VarChar(240)
  targetType                 String    @map("target_type") @db.VarChar(16)
  targetId                   String    @map("target_id") @db.Uuid
  copyrightedWorkDescription String    @map("copyrighted_work_description")
  ownershipBasis             String    @map("ownership_basis")
  originalSourceUrl          String?   @map("original_source_url")
  details                    String
  sourceReportId             String?   @map("source_report_id") @db.Uuid
  status                     String    @default("PENDING_EMAIL_VERIFICATION") @db.VarChar(32)
  assignedTo                 String?   @map("assigned_to") @db.Uuid
