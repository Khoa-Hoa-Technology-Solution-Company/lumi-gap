model ForumPostRevision {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  revision   Int
  title      String   @db.VarChar(240)
  body       String
  tags       String[] @default([])
  editedById String   @map("edited_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post     ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  editedBy User      @relation("ForumPostRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@unique([postId, revision])
  @@index([postId, createdAt])
  @@index([editedById, createdAt])
  @@map("forum_post_revisions")
}

model ForumCommentRevision {
