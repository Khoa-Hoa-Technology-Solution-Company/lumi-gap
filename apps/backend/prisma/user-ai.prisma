model UserAiConnection {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(100)
  provider      String   @db.VarChar(24)
  baseUrl       String   @map("base_url")
  encryptedKey  String?  @map("encrypted_key")
  model         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences   UserAiPreference[]

  @@index([userId])
  @@map("user_ai_connections")
}

model UserAiPreference {
  userId       String @id @map("user_id") @db.Uuid
  connectionId String? @map("connection_id") @db.Uuid
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection   UserAiConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@map("user_ai_preferences")
}

/**
 * Platform-wide AI connection chosen by an admin (same protocols as UserAiConnection, plus a fast and a deep model).
 * At most one is active (partial unique index in SQL). Without an active one the env GEMINI_* settings are used.
 * Text generation only: embeddings have their own PlatformEmbeddingConnection.
 */
model PlatformAiConnection {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  provider     String   @db.VarChar(24)
  baseUrl      String   @map("base_url")
  encryptedKey String?  @map("encrypted_key")
  fastModel    String   @map("fast_model")
  deepModel    String   @map("deep_model")
  isActive     Boolean  @default(false) @map("is_active")
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_ai_connections")
}

/**
 * OpenAI-compatible endpoint serving the embedding model the stored vectors were made with, chosen by an admin.
 * At most one is active (partial unique index in SQL). Without an active one the env Gemini key is used.
 * `model` is the provider's id for the model. Stored vectors keep env GEMINI_EMBEDDING_MODEL as their provenance, and
 * `verifiedSimilarity` is the cosine against stored vectors that proved they are comparable (null: none existed yet).
 */
model PlatformEmbeddingConnection {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(100)
  baseUrl            String   @map("base_url")
  encryptedKey       String?  @map("encrypted_key")
  model              String
  verifiedSimilarity Float?   @map("verified_similarity")
  isActive           Boolean  @default(false) @map("is_active")
  createdById        String?  @map("created_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_embedding_connections")
}

/**
 * Pool of platform API keys an admin manages per provider (GEMINI, OPENALEX). Calls use the enabled key with the
 * lowest `priority` that is not cooling down or marked invalid, and fail over to the next one when the provider rejects
 * the key. Without a usable pool key the env key (GEMINI_API_KEY / OPENALEX_API_KEY) is used. The key is encrypted
 * and bound to the row id; only `keyHint` (last 4 characters) is ever returned.
 */
model PlatformApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  provider      String    @db.VarChar(16)
  label         String    @db.VarChar(100)
  encryptedKey  String    @map("encrypted_key")
  keyHint       String    @map("key_hint") @db.VarChar(8)
  priority      Int       @default(100)
  isEnabled     Boolean   @default(true) @map("is_enabled")
  cooldownUntil DateTime? @map("cooldown_until") @db.Timestamptz(6)
  invalidAt     DateTime? @map("invalid_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  lastErrorAt   DateTime? @map("last_error_at") @db.Timestamptz(6)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  successCount  BigInt    @default(0) @map("success_count")
  failureCount  Int       @default(0) @map("failure_count")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([provider, priority])
  @@map("platform_api_keys")
}
