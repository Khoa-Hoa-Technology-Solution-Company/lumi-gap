model Submission {
  id                     String   @id @default(uuid()) @db.Uuid
  legacyMongoId          String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  projectId              String   @map("project_id") @db.Uuid
  sourceReportId         String?  @unique @map("source_report_id") @db.Uuid
  createdById            String   @map("created_by_id") @db.Uuid
  title                  String   @db.VarChar(300)
  abstractText           String?  @map("abstract_text")
  submissionType         String?  @map("submission_type") @db.VarChar(40)
  researchField          String?  @map("research_field") @db.VarChar(200)
  researchGoal           String?  @map("research_goal")
  researchQuestions      String[] @default([]) @map("research_questions")
  claimedResearchGap     String?  @map("claimed_research_gap")
  claimedContribution    String?  @map("claimed_contribution")
  methodology            String?
  scope                  String?
  keywords               String[] @default([])
  expectedReviewWorkload String?  @map("expected_review_workload") @db.VarChar(160)
  status                 String   @default("submitted") @db.VarChar(32)
  currentRevisionNumber  Int      @default(1) @map("current_revision_number")
  currentRevisionId      String?  @map("current_revision_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, createdAt])
  @@index([createdById])
  @@index([status, submissionType, researchField, createdAt])
  @@map("submissions")
}

model SubmissionAuthor {
  submissionId String @map("submission_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  position     Int

  @@id([submissionId, userId])
  @@unique([submissionId, position])
  @@index([userId])
  @@map("submission_authors")
}

model SubmissionDeclaredConflict {
  submissionId String @map("submission_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid

  @@id([submissionId, userId])
  @@index([userId])
  @@map("submission_declared_conflicts")
}

model SubmissionRevision {
  id               String   @id @default(uuid()) @db.Uuid
  legacyMongoId    String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  submissionId     String   @map("submission_id") @db.Uuid
  revisionNumber   Int      @map("revision_number")
  uploadedById     String   @map("uploaded_by_id") @db.Uuid
  responseToReview String?  @map("response_to_review")
  storageUri       String?  @map("storage_uri")
  checksumSha256   String?  @map("checksum_sha256") @db.Char(64)
  sizeBytes        Int      @default(0) @map("size_bytes")
  originalFileName String?  @map("original_file_name") @db.VarChar(255)
  contentSnapshot  String?  @map("content_snapshot")
  contentType      String   @default("PDF") @map("content_type") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([submissionId, revisionNumber])
  @@index([uploadedById])
  @@map("submission_revisions")
}

model ReviewerAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  legacyMongoId   String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  submissionId    String    @map("submission_id") @db.Uuid
  reviewRequestId String?   @unique @map("review_request_id") @db.Uuid
  reviewerId      String    @map("reviewer_id") @db.Uuid
  assignedById    String    @map("assigned_by_id") @db.Uuid
  anonymousCode   String    @unique @map("anonymous_code")
  status          String    @default("assigned") @db.VarChar(24)
  decision        String?   @db.VarChar(24)
  reviewText      String?   @map("review_text")
  dueAt           DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  conflictChecks  Json      @default("{}") @map("conflict_checks")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewerId, status, createdAt])
  @@index([submissionId, status])
  @@map("reviewer_assignments")
}

model AiPreReview {
  id                     String    @id @default(uuid()) @db.Uuid
  legacyMongoId          String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  submissionId           String    @map("submission_id") @db.Uuid
  requestedById          String    @map("requested_by_id") @db.Uuid
  provider               String?   @db.VarChar(80)
  model                  String?   @db.VarChar(160)
  status                 String    @default("QUEUED") @db.VarChar(24)
  summary                String?
  goalAlignment          Json?     @map("goal_alignment")
  rqCoverage             Json      @default("[]") @map("rq_coverage")
  unsupportedClaims      Json      @default("[]") @map("unsupported_claims")
  citationIssues         String[]  @default([]) @map("citation_issues")
  contributionComparison String?   @map("contribution_comparison")
  reviewFocusAreas       String[]  @default([]) @map("review_focus_areas")
  limitations            String[]  @default([])
  rawStructuredOutput    Json?     @map("raw_structured_output")
  errorMessage           String?   @map("error_message")
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([submissionId, createdAt])
  @@index([submissionId, status])
  @@map("ai_pre_reviews")
}

model ReviewConflict {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  submissionId  String    @map("submission_id") @db.Uuid
  reviewerId    String    @map("reviewer_id") @db.Uuid
  status        String    @db.VarChar(24)
  reason        String?
  detectedBy    String    @map("detected_by") @db.VarChar(16)
  resolvedById  String?   @map("resolved_by_id") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([submissionId, reviewerId])
  @@map("review_conflicts")
}

model ReviewTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  legacyMongoId   String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  name            String   @db.VarChar(200)
  description     String?
  submissionType  String?  @map("submission_type")
  source          String   @default("SYSTEM") @db.VarChar(16)
  ownerId         String?  @map("owner_id") @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  artifactType    String?  @map("artifact_type") @db.VarChar(40)
  status          String   @default("PUBLISHED") @db.VarChar(16)
  activeVersionId String?  @map("active_version_id") @db.Uuid
  active          Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([submissionType, active])
  @@index([source, ownerId, projectId, status])
  @@map("review_templates")
}

model ReviewTemplateVersion {
  id            String    @id @default(uuid()) @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  versionNumber Int       @map("version_number")
  reviewMode    String    @map("review_mode") @db.VarChar(32)
  description   String?
  guidelines    String[]  @default([])
  status        String    @default("DRAFT") @db.VarChar(16)
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@unique([templateId, versionNumber])
  @@index([templateId, status, versionNumber])
  @@map("review_template_versions")
}

model ReviewCriterion {
  id                 String   @id @default(uuid()) @db.Uuid
  legacyMongoId      String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  templateId         String   @map("template_id") @db.Uuid
  versionId          String   @map("version_id") @db.Uuid
  key                String   @db.VarChar(80)
  label              String   @db.VarChar(160)
  description        String?
  weight             Float?
  order              Int
  required           Boolean  @default(true)
  allowNotApplicable Boolean  @default(false) @map("allow_not_applicable")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([versionId, key])
  @@index([versionId, order])
  @@map("review_criteria")
}

model ReviewCriterionLevel {
  id          String   @id @default(uuid()) @db.Uuid
  criterionId String   @map("criterion_id") @db.Uuid
  label       String   @db.VarChar(120)
  description String?
  score       Int
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([criterionId, position])
  @@index([criterionId])
  @@map("review_criterion_levels")
}

model ReviewRequest {
  id                 String    @id @default(uuid()) @db.Uuid
  submissionId       String    @map("submission_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  requesterId        String    @map("requester_id") @db.Uuid
  templateVersionId  String    @map("template_version_id") @db.Uuid
  artifactRevisionId String    @map("artifact_revision_id") @db.Uuid
  status             String    @default("REQUESTED") @db.VarChar(24)
  message            String?
  dueAt              DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([requesterId, status, updatedAt])
  @@index([projectId, status, createdAt])
  @@index([submissionId, status])
  @@index([templateVersionId])
  @@map("review_requests")
}

model ExternalReviewInvitation {
  id                 String    @id @default(uuid()) @db.Uuid
  tokenHash          String    @unique @map("token_hash") @db.VarChar(128)
  reviewerEmail      String    @map("reviewer_email") @db.VarChar(320)
  invitedUserId      String?   @map("invited_user_id") @db.Uuid
  requesterId        String    @map("requester_id") @db.Uuid
  submissionId       String    @map("submission_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  templateVersionId  String    @map("template_version_id") @db.Uuid
  artifactRevisionId String    @map("artifact_revision_id") @db.Uuid
  status             String    @default("PENDING") @db.VarChar(24)
  message            String?
  dueAt              DateTime? @map("due_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  respondedAt        DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reviewerEmail, status, expiresAt])
  @@index([invitedUserId, status, expiresAt])
  @@index([requesterId, status, createdAt])
  @@index([submissionId, status])
  @@map("external_review_invitations")
}

model HumanReview {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  assignmentId      String    @map("assignment_id") @db.Uuid
  roundNumber       Int       @default(1) @map("round_number")
  reviewerId        String    @map("reviewer_id") @db.Uuid
  submissionId      String    @map("submission_id") @db.Uuid
  revisionId        String    @map("revision_id") @db.Uuid
  templateId        String?   @map("template_id") @db.Uuid
  templateVersionId String?   @map("template_version_id") @db.Uuid
  status            String    @default("DRAFT") @db.VarChar(16)
  overallComment    String?   @map("overall_comment")
  keyStrengths      String?   @map("key_strengths")
  keyConcerns       String?   @map("key_concerns")
  overallAssessment String?   @map("overall_assessment") @db.VarChar(24)
  weightedScore     Float?    @map("weighted_score")
  recommendation    String?   @db.VarChar(24)
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assignmentId, roundNumber])
  @@index([reviewerId, status])
  @@index([submissionId])
  @@index([templateVersionId])
  @@map("human_reviews")
}

model ReviewResponse {
  id                 String   @id @default(uuid()) @db.Uuid
  legacyMongoId      String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  reviewId           String   @map("review_id") @db.Uuid
  criterionKey       String   @map("criterion_key") @db.VarChar(80)
  comment            String
  evidence           String?
  rating             Int?
  assessment         String?  @db.VarChar(32)
  performanceLevelId String?  @map("performance_level_id") @db.Uuid
  score              Float?
  notApplicable      Boolean  @default(false) @map("not_applicable")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([reviewId, criterionKey])
  @@map("review_responses")
}

model ReviewRevisionItem {
  id          String   @id @default(uuid()) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  position    Int
  priority    String   @default("MAJOR") @db.VarChar(16)
  description String
  status      String   @default("OPEN") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([reviewId, position])
  @@index([reviewId, status])
  @@map("review_revision_items")
}

model ReviewRevisionResponse {
  id                   String   @id @default(uuid()) @db.Uuid
  revisionItemId       String   @map("revision_item_id") @db.Uuid
  submissionRevisionId String   @map("submission_revision_id") @db.Uuid
  responseText         String   @map("response_text")
  status               String   @default("ADDRESSED") @db.VarChar(16)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([revisionItemId, submissionRevisionId])
  @@index([submissionRevisionId])
  @@map("review_revision_responses")
}

model ResearchContribution {
  id                          String    @id @default(uuid()) @db.Uuid
  legacyMongoId               String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  contributorId               String    @map("contributor_id") @db.Uuid
  projectId                   String?   @map("project_id") @db.Uuid
  submissionId                String?   @map("submission_id") @db.Uuid
  contributionType            String    @map("contribution_type") @db.VarChar(48)
  description                 String?
  evidence                    String?
  provenance                  String    @db.VarChar(32)
  verificationStatus          String    @map("verification_status") @db.VarChar(32)
  visibility                  String    @default("PUBLIC") @db.VarChar(16)
  verifiedById                String?   @map("verified_by_id") @db.Uuid
  verifiedAt                  DateTime? @map("verified_at") @db.Timestamptz(6)
  sourceReviewAssignmentId    String?   @unique @map("source_review_assignment_id") @db.Uuid
  sourceProjectContributionId String?   @map("source_project_contribution_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([contributorId, createdAt])
  @@index([projectId])
  @@index([submissionId])
  @@index([sourceProjectContributionId])
  @@map("research_contributions")
}

model AiRun {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  ownerId           String    @map("owner_id") @db.Uuid
  projectId         String?   @map("project_id") @db.Uuid
  workspaceId       String?   @map("workspace_id") @db.Uuid
  jobType           String    @map("job_type") @db.VarChar(32)
  prompt            String?
  status            String    @default("queued") @db.VarChar(24)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3) @map("max_attempts")
  queueJobId        String?   @map("queue_job_id")
  costUsd           Decimal?  @map("cost_usd") @db.Decimal(18, 8)
  latencyMs         Int?      @map("latency_ms")
  resultSummary     String?   @map("result_summary")
  errorCode         String?   @map("error_code") @db.VarChar(120)
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelRequestedAt DateTime? @map("cancel_requested_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerId, createdAt])
  @@index([projectId, status, createdAt])
  @@map("ai_runs")
}

model AiRunEvidence {
  runId      String @map("run_id") @db.Uuid
  evidenceId String @map("evidence_id") @db.Uuid
  position   Int

  @@id([runId, evidenceId])
  @@map("ai_run_evidence")
}
