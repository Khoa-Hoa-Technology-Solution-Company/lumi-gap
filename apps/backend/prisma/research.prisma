model ResearchGap {
  id                        String   @id @default(uuid()) @db.Uuid
  legacyMongoId             String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  topic                     String
  normalizedTopic           String   @map("normalized_topic")
  title                     String   @db.VarChar(200)
  description               String
  rationale                 String
  gapType                   String   @default("OTHER") @map("gap_type") @db.VarChar(64)
  scope                     String?
  establishedKnowledge      String?  @map("established_knowledge")
  observedLimitation        String?  @map("observed_limitation")
  missingEvidence           String?  @map("missing_evidence")
  significanceExplanation   String?  @map("significance_explanation")
  suggestedResearchQuestion String?  @map("suggested_research_question")
  validationStatus          String   @default("CANDIDATE") @map("validation_status") @db.VarChar(32)
  gapConfidence             String   @default("LOW") @map("gap_confidence") @db.VarChar(16)
  researchPriority          String   @default("MODERATE") @map("research_priority") @db.VarChar(16)
  origin                    String   @default("AI_ASSISTED") @db.VarChar(24)
  version                   Int      @default(1)
  assessmentStatus          String   @default("PROPOSED") @map("assessment_status") @db.VarChar(32)
  assessmentRationale       String   @default("") @map("assessment_rationale")
  assumptions               String   @default("")
  confidence                Float    @default(0.5)
  probe                     Json?
  intersectionCount         Int?     @map("intersection_count")
  parentCounts              Json?    @map("parent_counts")
  parentTrend               Json?    @map("parent_trend")
  globalEvidence            Json?    @map("global_evidence")
  evidenceConfidence        Float?   @map("evidence_confidence")
  evidenceScopeSize         Int?     @map("evidence_scope_size")
  projectEvidence           Json?    @map("project_evidence")
  source                    String   @db.VarChar(16)
  sourceReportId            String?  @map("source_report_id") @db.Uuid
  analysisId                String?  @map("analysis_id") @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  projectId                 String?  @map("project_id") @db.Uuid
  corpusId                  String?  @map("corpus_id") @db.Uuid
  status                    String   @default("active") @db.VarChar(16)
  forumShareable            Boolean  @default(false) @map("forum_shareable")
  /// Gap Closure Protocol result: NOT_CHECKED | CLOSED | OPEN_CERTIFIED | ABSTAIN.
  closureStatus             String   @default("NOT_CHECKED") @map("closure_status") @db.VarChar(24)
  /// PICOC facets of the gap research question ({ population, intervention, comparison, outcome, context }).
  questionFacets            Json?    @map("question_facets")
  latestClosureCheckId      String?  @map("latest_closure_check_id") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([normalizedTopic, confidence])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([closureStatus])
  @@index([validationStatus, gapType, createdAt])
  @@index([analysisId])
  @@index([projectId])
  @@index([corpusId])
  @@map("research_gaps")
}

