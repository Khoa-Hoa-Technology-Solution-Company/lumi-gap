/// One run of the Gap Closure Protocol for a gap or a calibration question (targetKind + targetId).
model GapClosureCheck {
  id                  String    @id @default(uuid()) @db.Uuid
  targetKind          String    @map("target_kind") @db.VarChar(24)
  targetId            String    @map("target_id") @db.Uuid
  protocolVersion     String    @map("protocol_version") @db.VarChar(32)
  status              String    @default("QUEUED") @db.VarChar(16)
  question            String
  facets              Json      @default("{}")
  queries             Json      @default("[]")
  yearFrom            Int?      @map("year_from")
  yearTo              Int?      @map("year_to")
  judgeKind           String?   @map("judge_kind") @db.VarChar(16)
  coverageCheckId     String?   @map("coverage_check_id") @db.Uuid
  calibrationId       String?   @map("calibration_id") @db.Uuid
  delta               Float?
  epsHat              Float?    @map("eps_hat")
  pHat                Float?    @map("p_hat")
  bound               Float?
  maxFalseNovelty     Float?    @map("max_false_novelty")
  decision            String?   @db.VarChar(24)
  decisionReasons     Json      @default("[]") @map("decision_reasons")
  witnessDocumentId   String?   @map("witness_document_id") @db.Uuid
  corroborated        Boolean   @default(false)
  errorMessage        String?   @map("error_message")
  createdById         String    @map("created_by_id") @db.Uuid
  decidedById         String?   @map("decided_by_id") @db.Uuid
  decidedAt           DateTime? @map("decided_at") @db.Timestamptz(6)
  creditTransactionId String?   @map("credit_transaction_id") @db.Uuid
  creditCost          Int?      @map("credit_cost")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([targetKind, targetId, createdAt])
  @@index([status, updatedAt])
  @@map("gap_closure_checks")
}

/// A document screened by a closure check: a corpus paper or an OpenAlex snapshot.
model GapClosureDocument {
  id                  String    @id @default(uuid()) @db.Uuid
  checkId             String    @map("check_id") @db.Uuid
  /// Paper id, else "openalex:<id>", else "doi:<doi>"; one row per document per check.
  dedupeKey           String    @map("dedupe_key")
  paperId             String?   @map("paper_id") @db.Uuid
  openalexId          String?   @map("openalex_id")
  doi                 String?
  title               String
  abstractText        String?   @map("abstract_text")
  publicationYear     Int?      @map("publication_year")
  retrievedFrom       String    @map("retrieved_from") @db.VarChar(16)
  queryIndex          Int       @map("query_index")
  rank                Int
  aiLabel             String?   @map("ai_label") @db.VarChar(16)
  aiQuote             String?   @map("ai_quote")
  aiFacets            Json?     @map("ai_facets")
  aiQuoteVerified     Boolean   @default(false) @map("ai_quote_verified")
  humanLabel          String?   @map("human_label") @db.VarChar(16)
  humanQuote          String?   @map("human_quote")
  humanFacets         Json?     @map("human_facets")
  reviewerId          String?   @map("reviewer_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamptz(6)
  secondLabel         String?   @map("second_label") @db.VarChar(16)
  secondReviewerId    String?   @map("second_reviewer_id") @db.Uuid
  secondReviewedAt    DateTime? @map("second_reviewed_at") @db.Timestamptz(6)
  /// The quoted sentence states a limitation or future work (source of corroboration).
  limitationStatement Boolean   @default(false) @map("limitation_statement")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([checkId, dedupeKey])
  @@index([paperId])
  @@map("gap_closure_documents")
}

/// Coverage estimate: m reference DOIs from an independent source, x of them missing from LumiGap and OpenAlex.
model CoverageCheck {
  id              String   @id @default(uuid()) @db.Uuid
  topic           String   @db.VarChar(300)
  normalizedTopic String   @map("normalized_topic") @db.VarChar(300)
  projectId       String?  @map("project_id") @db.Uuid
  referenceSource String   @map("reference_source")
  m               Int
  x               Int
  delta           Float
  pHat            Float    @map("p_hat")
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([normalizedTopic, createdAt])
  @@index([projectId])
  @@map("coverage_checks")
}

model CoverageCheckItem {
  coverageCheckId String  @map("coverage_check_id") @db.Uuid
  doi             String
  position        Int
  title           String?
  foundLocal      Boolean @map("found_local")
  foundOpenAlex   Boolean @map("found_openalex")
  paperId         String? @map("paper_id") @db.Uuid
  openalexId      String? @map("openalex_id")

  @@id([coverageCheckId, doi])
  @@map("coverage_check_items")
}

/// Miss rate of the whole search + screening procedure, measured on questions known to be answered.
model ClosureCalibration {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  domain          String    @db.VarChar(200)
  judgeKind       String    @map("judge_kind") @db.VarChar(16)
  protocolVersion String    @map("protocol_version") @db.VarChar(32)
  status          String    @default("DRAFT") @db.VarChar(16)
  delta           Float
  n               Int       @default(0)
  misses          Int       @default(0)
  epsHat          Float?    @map("eps_hat")
  createdById     String    @map("created_by_id") @db.Uuid
  computedAt      DateTime? @map("computed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([domain, judgeKind])
  @@map("closure_calibrations")
}

