model Report {
  id                   String    @id @default(uuid()) @db.Uuid
  legacyMongoId        String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  userId               String    @map("user_id") @db.Uuid
  projectId            String?   @map("project_id") @db.Uuid
  title                String?   @db.VarChar(240)
  topic                String?
  query                String
  status               String    @default("queued") @db.VarChar(24)
  artifactType         String    @default("GENERAL_REPORT") @map("artifact_type") @db.VarChar(32)
  artifactStatus       String    @default("DRAFT") @map("artifact_status") @db.VarChar(24)
  isAiGenerated        Boolean   @default(true) @map("is_ai_generated")
  markdown             String?
  researchGapSnapshots Json      @default("[]") @map("research_gap_snapshots")
  evidenceSnapshot     Json      @default("[]") @map("evidence_snapshot")
  modelVersion         String    @default("") @map("model_version")
  promptVersion        String    @default("") @map("prompt_version")
  cacheKey             String?   @map("cache_key")
  groundingChecks      Json?     @map("grounding_checks")
  yearFrom             Int?      @map("year_from")
  yearTo               Int?      @map("year_to")
  scopeFilters         Json      @default("{}") @map("scope_filters")
  language             String    @default("auto") @db.VarChar(8)
  deepAnalysis         Boolean   @default(false) @map("deep_analysis")
  fast                 Boolean   @default(false)
  errorMessage         String?   @map("error_message")
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  creditTransactionId  String?   @map("credit_transaction_id") @db.Uuid
  creditCost           Int?      @map("credit_cost")
  creditAction         String?   @map("credit_action")
  creditRefundedAt     DateTime? @map("credit_refunded_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([status, updatedAt])
  @@index([cacheKey])
  @@map("reports")
}

