model ManuscriptFile {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  path String @db.VarChar(240)
  kind String @db.VarChar(16)
  version Int @default(1)
  sequence Int @default(0)
  crdtState Bytes? @map("crdt_state")
  writingBaseline Json? @map("writing_baseline")
  assetData Bytes? @map("asset_data")
  mimeType String? @map("mime_type") @db.VarChar(80)
  sizeBytes Int @default(0) @map("size_bytes")
  checksum String? @db.Char(64)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([id, workspaceId])
  @@index([workspaceId, deletedAt, path])
  @@map("manuscript_files")
}

model ManuscriptUpdate {
  id String @id @default(uuid()) @db.Uuid
  fileId String @map("file_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  clientSessionId String @map("client_session_id") @db.Uuid
  clientSequence Int @map("client_sequence")
  serverSequence Int @map("server_sequence")
  update Bytes
  writingSpans Json? @map("writing_spans")
  checksum String @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([fileId, actorId, clientSessionId, clientSequence])
  @@index([fileId, serverSequence])
  @@map("manuscript_updates")
}

model ManuscriptSnapshot {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  label String @db.VarChar(160)
  sourceVersion Int @map("source_version")
  manifest Json
  collaborationState Json? @map("collaboration_state")
  writingState Json? @map("writing_state")
  checksum String @db.Char(64)
  createdById String @map("created_by_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([workspaceId, createdById, clientKey])
  @@unique([id, projectId])
  @@index([workspaceId, createdAt])
  @@map("manuscript_snapshots")
}

model ManuscriptWritingReport {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  snapshotId String @unique @map("snapshot_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  status String @default("QUEUED") @db.VarChar(16)
  result Json?
  inputHash String? @map("input_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  calculatedAt DateTime? @map("calculated_at") @db.Timestamptz(6)
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("manuscript_writing_reports")
}

model ManuscriptSnapshotAsset {
  snapshotId String @map("snapshot_id") @db.Uuid
  fileId String @map("file_id") @db.Uuid
  data Bytes
  @@id([snapshotId, fileId])
  @@map("manuscript_snapshot_assets")
}

model ManuscriptCompilation {
  texLiveVersion String @default("2022") @map("tex_live_version") @db.VarChar(4)
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid
  requestedById String @map("requested_by_id") @db.Uuid
  status String @default("BLOCKED") @db.VarChar(24)
  diagnostics String @default("")
  pdfData Bytes? @map("pdf_data")
  syncTexData Bytes? @map("synctex_data")
  checksum String? @db.Char(64)
  toolchain String? @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  @@index([snapshotId, createdAt])
  @@map("manuscript_compilations")
}

model ManuscriptSuggestion {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  fileId String @map("file_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  original String
  replacement String
  note String @default("") @db.VarChar(2000)
  anchor Json
  sourceSequence Int @map("source_sequence")
  status String @default("PENDING") @db.VarChar(16)
  revision Int @default(1)
  resolvedById String? @map("resolved_by_id") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([workspaceId, authorId, clientKey])
  @@index([workspaceId, status, createdAt])
  @@map("manuscript_suggestions")
}

model ManuscriptRemoteBinding {
  workspaceId String @id @map("workspace_id") @db.Uuid
  repository String @db.VarChar(201)
  branch String @db.VarChar(200)
  head String @db.Char(40)
  baseline Json
  revision Int @default(1)
  updatedById String @map("updated_by_id") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("manuscript_remote_bindings")
}

model ManuscriptAttributionCheck {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  snapshotId String @map("snapshot_id") @db.Uuid
  version Int
  status String @default("PENDING_CONFIRMATION") @db.VarChar(24)
  proposedAuthors Json @default("[]") @map("proposed_authors")
  acknowledgements Json @default("[]")
  acknowledgementText String @default("") @map("acknowledgement_text")
  omittedContributors Json @default("[]") @map("omitted_contributors")
  snapshotDigestSha256 String @map("snapshot_digest_sha256") @db.Char(64)
  createdById String @map("created_by_id") @db.Uuid
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([snapshotId, version])
  @@unique([id, projectId])
  @@index([projectId, workspaceId, snapshotId])
  @@map("manuscript_attribution_checks")
}

model ManuscriptAttributionDecision {
  id String @id @default(uuid()) @db.Uuid
  checkId String @map("check_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  participantKind String @map("participant_kind") @db.VarChar(24)
  decision String @db.VarChar(16)
  note String @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([checkId, createdAt])
  @@index([checkId, userId, createdAt])
  @@map("manuscript_attribution_decisions")
}
