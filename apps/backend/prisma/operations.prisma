model CreditTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  legacyMongoId         String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  userId                String   @map("user_id") @db.Uuid
  type                  String   @db.VarChar(16)
  action                String   @db.VarChar(64)
  amount                Int
  balanceAfter          Int      @map("balance_after")
  targetKind            String?  @map("target_kind") @db.VarChar(32)
  targetLegacyMongoId   String?  @map("target_legacy_mongo_id") @db.VarChar(24)
  targetUuid            String?  @map("target_uuid") @db.Uuid
  idempotencyKey        String   @unique @map("idempotency_key")
  status                String   @default("applied") @db.VarChar(16)
  refundedTransactionId String?  @map("refunded_transaction_id") @db.Uuid
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([targetKind, targetUuid])
  @@map("credit_transactions")
}

model PaymentOrder {
  id            String    @id @default(uuid()) @db.Uuid
  legacyMongoId String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  orderCode     BigInt    @unique @map("order_code")
  userId        String    @map("user_id") @db.Uuid
  amount        Int
  credits       Int
  status        String    @default("pending") @db.VarChar(16)
  paymentLinkId String?   @map("payment_link_id")
  checkoutUrl   String?   @map("checkout_url")
  qrCode        String?   @map("qr_code")
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@map("payment_orders")
}

model Notification {
  id                  String   @id @default(uuid()) @db.Uuid
  legacyMongoId       String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  userId              String?  @map("user_id") @db.Uuid
  role                String?  @db.VarChar(32)
  title               String
  message             String
  type                String
  eventKey            String?  @unique @map("event_key") @db.VarChar(200)
  emailPayload        Json?    @map("email_payload")
  emailStatus         String?  @map("email_status") @db.VarChar(24)
  emailClaimedAt      DateTime? @map("email_claimed_at") @db.Timestamptz(6)
  emailSentAt         DateTime? @map("email_sent_at") @db.Timestamptz(6)
  dispatchedAt        DateTime? @map("dispatched_at") @db.Timestamptz(6)
  pushSentAt          DateTime? @map("push_sent_at") @db.Timestamptz(6)
  paperId             String?  @map("paper_id") @db.Uuid
  targetKind          String?  @map("target_kind") @db.VarChar(32)
  targetLegacyMongoId String?  @map("target_legacy_mongo_id") @db.VarChar(24)
  targetUuid          String?  @map("target_uuid") @db.Uuid
  isRead              Boolean  @default(false) @map("is_read")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, isRead, createdAt])
  @@index([role, createdAt])
  @@index([targetKind, targetUuid])
  @@index([emailStatus, dispatchedAt])
  @@map("notifications")
}

model NotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  @@id([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

