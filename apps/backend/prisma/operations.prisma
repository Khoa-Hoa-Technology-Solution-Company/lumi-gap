model OpenAlexIngestPartition {
  id                String    @id @default(uuid()) @db.Uuid
  legacyMongoId     String?   @unique @map("legacy_mongo_id") @db.VarChar(24)
  campaignId        String    @map("campaign_id") @db.Uuid
  partitionKey      String    @map("partition_key")
  cohortId          String    @map("cohort_id")
  stratumKey        String    @map("stratum_key")
  filterExpression  String    @map("filter_expression")
  plannedPopulation Int       @map("planned_population")
  targetCount       Int       @map("target_count")
  selectionMethod   String    @map("selection_method") @db.VarChar(24)
  seed              Int?
  state             String    @default("planned") @db.VarChar(24)
  checkpointCursor  String?   @map("checkpoint_cursor")
  acceptedCount     Int       @default(0) @map("accepted_count")
  committedAttempts Int       @default(0) @map("committed_attempts")
  checkpointVersion Int       @default(0) @map("checkpoint_version")
  leaseOwnerId      String?   @map("lease_owner_id")
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  leaseHeartbeatAt  DateTime? @map("lease_heartbeat_at") @db.Timestamptz(6)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([campaignId, partitionKey])
  @@index([campaignId, state, leaseExpiresAt])
  @@map("openalex_ingest_partitions")
}

