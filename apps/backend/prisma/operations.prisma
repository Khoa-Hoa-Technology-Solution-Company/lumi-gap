model PaperCohortMembership {
  id               String   @id @default(uuid()) @db.Uuid
  legacyMongoId    String?  @unique @map("legacy_mongo_id") @db.VarChar(24)
  paperId          String   @map("paper_id") @db.Uuid
  cohortId         String   @map("cohort_id")
  campaignId       String   @map("campaign_id") @db.Uuid
  stratumKey       String   @map("stratum_key")
  samplingWeight   Float?   @map("sampling_weight")
  selectionMethod  String   @map("selection_method") @db.VarChar(32)
  policyVersion    String   @map("policy_version")
  reason           String   @db.VarChar(32)
  sourcePopulation Int?     @map("source_population")
  selectedAt       DateTime @map("selected_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([paperId, cohortId, campaignId], map: "paper_cohort_campaign_unique")
  @@index([cohortId, stratumKey])
  @@index([campaignId, paperId])
  @@index([campaignId, cohortId, stratumKey, paperId])
  @@map("paper_cohort_memberships")
}
