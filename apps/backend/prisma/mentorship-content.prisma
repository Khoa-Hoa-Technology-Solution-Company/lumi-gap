// Private invitation files are separate from the project's research library.
// Byte storage follows ProjectPaperFile; only explicit request links share a file.
model MentorshipAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(180)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  byteSize     Int      @map("byte_size")
  sha256       String   @db.VarChar(64)
  content      Bytes
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, uploadedById, createdAt])
  @@map("mentorship_attachments")
}

model MentorshipRequestAttachment {
  requestId    String @map("request_id") @db.Uuid
  attachmentId String @map("attachment_id") @db.Uuid

  @@id([requestId, attachmentId])
  @@index([attachmentId])
  @@map("mentorship_request_attachments")
}

model MentorshipDraft {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  direction     String   @db.VarChar(32)
  mentorRole    String   @default("PRIMARY") @map("mentor_role") @db.VarChar(16)
  message       String   @default("")
  attachmentIds String[] @default([]) @map("attachment_ids") @db.Uuid
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId, direction])
  @@map("mentorship_drafts")
}
