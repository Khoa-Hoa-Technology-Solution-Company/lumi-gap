model ContributionEvaluationRule {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  version Int
  title String @db.VarChar(240)
  rationale String
  defaultWeight Int @default(1) @map("default_weight")
  maxWeight Int @default(100) @map("max_weight")
  createdById String @map("created_by_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([projectId, version])
  @@unique([projectId, clientKey])
  @@unique([id, projectId])
  @@map("contribution_evaluation_rules")
}

model ContributionOutcome {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  key String @db.VarChar(100)
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([projectId, key])
  @@unique([id, projectId])
  @@map("contribution_outcomes")
}

model ContributionOutcomeSource {
  contributionId String @id @map("contribution_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  outcomeId String @map("outcome_id") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([projectId, outcomeId])
  @@map("contribution_outcome_sources")
}

model ContributionOutcomeEvaluation {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  outcomeId String @map("outcome_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  version Int
  payload Json
  payloadHash String @map("payload_hash") @db.Char(64)
  createdById String @map("created_by_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([outcomeId, version])
  @@unique([projectId, clientKey])
  @@unique([id, projectId])
  @@index([projectId, outcomeId])
  @@map("contribution_outcome_evaluations")
}

model ContributionEvaluationDecision {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  evaluationId String @map("evaluation_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// PARTICIPANT, WEIGHT, CHALLENGE, or RESOLUTION (original objector only).
  kind String @db.VarChar(24)
  decision String @db.VarChar(16)
  note String @default("")
  payloadHash String @map("payload_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([evaluationId, userId, kind])
  @@index([projectId, evaluationId])
  @@map("contribution_evaluation_decisions")
}

model ContributionEvaluationState {
  projectId String @id @map("project_id") @db.Uuid
  version BigInt @default(0)
  @@map("contribution_evaluation_states")
}

model ContributionEvaluationRun {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  periodId String @map("period_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  status String @default("QUEUED") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([projectId, clientKey])
  @@unique([id, projectId])
  @@index([status, createdAt])
  @@map("contribution_evaluation_runs")
}

model ContributionEvaluationSnapshot {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  periodId String @map("period_id") @db.Uuid
  ruleId String @map("rule_id") @db.Uuid
  runId String @unique @map("run_id") @db.Uuid
  inputHash String @map("input_hash") @db.Char(64)
  inputVersion BigInt @map("input_version")
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([id, projectId])
  @@index([projectId, periodId, createdAt])
  @@map("contribution_evaluation_snapshots")
}
