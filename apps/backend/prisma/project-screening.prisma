model ScreeningSettings {
  consensusWindowHours Int @default(48) @map("consensus_window_hours")
  screeningMode String? @map("screening_mode") @db.VarChar(24)
  preferredAdjudicatorId String? @map("preferred_adjudicator_id") @db.Uuid
  adjudicationCoordinatorIds String[] @default([]) @map("adjudication_coordinator_ids") @db.Uuid
  adjudicationReminderHours Int @default(72) @map("adjudication_reminder_hours")
  adjudicationReassignHours Int @default(168) @map("adjudication_reassign_hours")
  statementWindowHours Int @default(48) @map("statement_window_hours")
  authorizedAdjudicatorIds String[] @default([]) @map("authorized_adjudicator_ids") @db.Uuid
  allowConservativeFullText Boolean @default(false) @map("allow_conservative_full_text")
  reviewMode String @default("INDEPENDENT") @map("review_mode") @db.VarChar(24)
  blindReview Boolean @default(true) @map("blind_review")
  resolutionPolicy String @default("CONSENSUS") @map("resolution_policy") @db.VarChar(24)
  projectId String @id @map("project_id") @db.Uuid
  version Int @default(1)
  requiredReviewers Int @default(2) @map("required_reviewers")
  consensusPolicy String @default("UNANIMOUS") @map("consensus_policy") @db.VarChar(24)
  aiAssisted Boolean @default(false) @map("ai_assisted")
  inclusionCriteria String[] @default([]) @map("inclusion_criteria")
  exclusionCriteria String[] @default([]) @map("exclusion_criteria")
  researchQuestions String[] @default([]) @map("research_questions")
  stages String[] @default([])
  discoveryGoalEnabled Boolean @default(false) @map("discovery_goal_enabled")
  discoveryGoalTarget Int @default(2) @map("discovery_goal_target")
  discoveryGoalPeriod String @default("WEEK") @map("discovery_goal_period") @db.VarChar(16)
  discoveryGoalPaused Boolean @default(false) @map("discovery_goal_paused")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("screening_settings")
}
model ScreeningAdjudicationCase {
  id String @id @default(uuid()) @db.Uuid
  finalDecisionId String? @unique @map("final_decision_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roundId String @map("round_id") @db.Uuid
  active Boolean @default(true)
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  status String @default("COLLECTING") @db.VarChar(32)
  version Int @default(1)
  packetVersion Int @default(1) @map("packet_version")
  packet Json
  reviewerIds String[] @map("reviewer_ids") @db.Uuid
  requestedByIds String[] @map("requested_by_ids") @db.Uuid
  deadline DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  @@unique([id, projectId])
  @@index([projectId, roundId, createdAt])
  @@map("screening_adjudication_cases")
}
model ScreeningAdjudicationInvitation {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String @db.VarChar(32)
  status String @default("SENT") @db.VarChar(16)
  responseReason String? @map("response_reason")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt DateTime? @map("responded_at") @db.Timestamptz(6)
  @@unique([caseId, userId])
  @@index([projectId, userId, status])
  @@map("screening_adjudication_invitations")
}
model ScreeningAdjudicationStatement {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  packetVersion Int @map("packet_version")
  revision Int
  useExisting Boolean @map("use_existing")
  text String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([caseId, reviewerId, revision])
  @@map("screening_adjudication_statements")
}
model ScreeningAdjudicationConflict {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  caseId String @map("case_id") @db.Uuid
  invitationId String @map("invitation_id") @db.Uuid
  reportedById String @map("reported_by_id") @db.Uuid
  reason String
  resolvedById String? @map("resolved_by_id") @db.Uuid
  resolution String?
  upheld Boolean?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  @@map("screening_adjudication_conflicts")
}
model ScreeningRound {
  consensusStartedAt DateTime? @map("consensus_started_at") @db.Timestamptz(6)
  consensusDeadline DateTime? @map("consensus_deadline") @db.Timestamptz(6)
  legacyNeedsAudit Boolean @default(false) @map("legacy_needs_audit")
  finalizerId String? @map("finalizer_id") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  paperId String @map("paper_id") @db.Uuid
  number Int
  phase String @db.VarChar(24)
  active Boolean @default(true)
  settings Json
  status String @default("NOT_REVIEWED") @db.VarChar(24)
  version Int @default(1)
  unblindedAt DateTime? @map("unblinded_at") @db.Timestamptz(6)
  independenceCompromised Boolean @default(false) @map("independence_compromised")
  createdById String @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([id, projectId])
  @@unique([projectId, paperId, number])
  @@index([projectId, active, status])
  @@map("screening_rounds")
}
model ScreeningAssignment {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roundId String @map("round_id") @db.Uuid
  reviewerId String @map("reviewer_id") @db.Uuid
  active Boolean @default(true)
  revision Int @default(1)
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)
  dueAt DateTime? @map("due_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([roundId, reviewerId])
  @@unique([id, projectId])
  @@index([projectId, reviewerId, active, submittedAt])
  @@map("screening_assignments")
}
model ScreeningReview {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  revision Int
  decision String @db.VarChar(16)
  exclusionReason String @default("") @map("exclusion_reason") @db.VarChar(500)
  comment String @default("")
  scope String? @db.VarChar(24)
  fullTextReference String? @map("full_text_reference")
  researchQuestions Json @default("[]") @map("research_questions")
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  @@unique([assignmentId, revision])
  @@index([projectId, assignmentId])
  @@map("screening_reviews")
}
model ScreeningFinalDecision {
  resolutionType String? @map("resolution_type") @db.VarChar(32)
  exclusionReason String? @map("exclusion_reason") @db.VarChar(500)
  sourceMaterial String? @map("source_material")
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roundId String @map("round_id") @db.Uuid
  roundVersion Int @map("round_version")
  decision String @db.VarChar(16)
  source String @db.VarChar(16)
  reason String
  resolverId String? @map("resolver_id") @db.Uuid
  reviewIds String[] @map("review_ids") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([roundId, roundVersion])
  @@unique([id, projectId, roundId])
  @@index([projectId, roundId, createdAt])
  @@map("screening_final_decisions")
}
model ScreeningAudit {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roundId String? @map("round_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  type String @db.VarChar(48)
  details Json @default("{}")
  clientKey String? @map("client_key") @db.Uuid
  requestHash String? @map("request_hash") @db.VarChar(64)
  result Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([projectId, actorId, clientKey])
  @@index([projectId, roundId, createdAt])
  @@map("screening_audit")
}
model ScreeningLegacyRecord {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  paperId String @map("paper_id") @db.Uuid
  snapshot Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([projectId, paperId])
  @@map("screening_legacy_records")
}
model ScreeningAiSuggestion {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  roundId String @map("round_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  clientKey String @map("client_key") @db.Uuid
  status String @default("QUEUED") @db.VarChar(16)
  input Json
  inputHash String @map("input_hash") @db.VarChar(64)
  result Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  generatedAt DateTime? @map("generated_at") @db.Timestamptz(6)
  @@unique([projectId, actorId, clientKey])
  @@index([projectId, roundId, createdAt])
  @@index([status, createdAt])
  @@map("screening_ai_suggestions")
}
